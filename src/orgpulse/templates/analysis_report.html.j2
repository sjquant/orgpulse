<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ t("analysis.title") }}</title>
  {% include "analysis_report/_styles.css.j2" %}
</head>
<body>
  <div class="shell">
    <header class="hero">
      <p class="eyebrow">{{ t("analysis.eyebrow") }}</p>
      <h1 id="report-title">{{ t("analysis.title") }}</h1>
      <p id="report-subtitle" class="subtitle"></p>
    </header>
    <section class="panel controls-panel">
      <div class="controls-grid">
        <label class="control" for="view-select">
          <span>{{ t("analysis.view") }}</span>
          <select id="view-select" data-control="view"></select>
        </label>
        <label class="control" for="metric-select">
          <span>{{ t("analysis.metric") }}</span>
          <select id="metric-select" data-control="metric"></select>
        </label>
        <label class="control" for="period-select">
          <span>{{ t("analysis.period") }}</span>
          <select id="period-select" data-control="period"></select>
        </label>
        <label class="control" for="top-n-select">
          <span>{{ t("analysis.top_series") }}</span>
          <select id="top-n-select" data-control="top-n">
            <option value="5">Top 5</option>
            <option value="8">Top 8</option>
            <option value="12">Top 12</option>
          </select>
        </label>
        <label class="control" for="search-input">
          <span>{{ t("analysis.series_filter") }}</span>
          <input id="search-input" data-control="search" type="search" placeholder="{{ t('analysis.series_filter_placeholder') }}">
        </label>
        <label class="control" for="focus-series-select">
          <span>{{ t("analysis.single_series_focus") }}</span>
          <select id="focus-series-select" data-control="focus-series"></select>
        </label>
      </div>
    </section>
    <section class="summary-grid" id="summary-cards"></section>
    <section class="panel chart-panel">
      <div class="panel-header">
        <div>
          <p class="panel-kicker">{{ t("analysis.trend_view") }}</p>
          <h2 id="chart-title">{{ t("analysis.trend") }}</h2>
        </div>
        <p id="chart-caption" class="caption"></p>
      </div>
      <div id="chart-root" class="chart-root"></div>
      <div id="chart-legend" class="legend"></div>
    </section>
    <div class="two-column-layout">
      <section class="panel">
        <div class="panel-header">
          <div>
            <p class="panel-kicker">{{ t("analysis.selected_period") }}</p>
            <h2 id="diagnostics-title">{{ t("analysis.spike_diagnostics") }}</h2>
          </div>
        </div>
        <div id="diagnostics-root"></div>
      </section>
      <section class="panel">
        <div class="panel-header">
          <div>
            <p class="panel-kicker">{{ t("analysis.ranking") }}</p>
            <h2 id="table-title">{{ t("analysis.current_ranking") }}</h2>
          </div>
        </div>
        <div id="table-root"></div>
      </section>
    </div>
  </div>
  <script id="report-i18n" type="application/json">{{ report_i18n_json }}</script>
  <script id="report-data" type="application/json">{{ report_payload_json | safe }}</script>
  {% include "analysis_report/_app.js.j2" %}
</body>
</html>
