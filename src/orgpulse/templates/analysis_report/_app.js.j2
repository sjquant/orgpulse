  <script>
    const i18n = JSON.parse(document.getElementById("report-i18n").textContent);
    const report = JSON.parse(document.getElementById("report-data").textContent);
    const viewCatalog = {
      period: { label: t("analysis.period"), data: report.views.period },
      repository: { label: t("common.repository"), data: report.views.repository },
      author: { label: t("common.author", "Author"), data: report.views.author }
    };
    const state = {
      view: report.initial_view,
      metric: report.views[report.initial_view].default_metric,
      periodKey: report.default_period_key,
      topN: report.default_top_n,
      search: "",
      focusSeriesKey: ""
    };

    const palette = [
      "#0e5c52", "#d96f3d", "#5e6ad2", "#b5517b",
      "#4f7f25", "#8b4cd7", "#2176ae", "#8c5a1f",
      "#2c9988", "#c23a3a", "#4d4da8", "#a8802d"
    ];

    const viewSelect = document.getElementById("view-select");
    const metricSelect = document.getElementById("metric-select");
    const periodSelect = document.getElementById("period-select");
    const topNSelect = document.getElementById("top-n-select");
    const searchInput = document.getElementById("search-input");
    const focusSeriesSelect = document.getElementById("focus-series-select");
    const summaryCards = document.getElementById("summary-cards");
    const chartRoot = document.getElementById("chart-root");
    const chartLegend = document.getElementById("chart-legend");
    const diagnosticsRoot = document.getElementById("diagnostics-root");
    const tableRoot = document.getElementById("table-root");
    const chartTitle = document.getElementById("chart-title");
    const chartCaption = document.getElementById("chart-caption");
    const tableTitle = document.getElementById("table-title");
    const diagnosticsTitle = document.getElementById("diagnostics-title");
    const reportTitle = document.getElementById("report-title");
    const reportSubtitle = document.getElementById("report-subtitle");

    initialize();

    function initialize() {
      reportTitle.textContent = i18n.locale === "ko" ? `${report.target_org} 진단` : `${report.target_org} diagnostics`;
      reportSubtitle.textContent = i18n.locale === "ko"
        ? `${report.grain} 단위, ${report.time_anchor} 기준, 매칭된 PR ${formatValue(report.matched_pull_request_count, "int")}개, 분포 절단값 ${report.distribution_percentile}퍼센타일`
        : `${report.grain} grain anchored on ${report.time_anchor} with ${formatValue(report.matched_pull_request_count, "int")} matched pull requests and a ${report.distribution_percentile}th percentile distribution cutoff`;
      populateViewOptions();
      populatePeriodOptions();
      syncMetricOptions();
      topNSelect.value = String(report.default_top_n);
      render();
      viewSelect.addEventListener("change", onViewChange);
      metricSelect.addEventListener("change", onMetricChange);
      periodSelect.addEventListener("change", onPeriodChange);
      topNSelect.addEventListener("change", onTopNChange);
      searchInput.addEventListener("input", onSearchChange);
      focusSeriesSelect.addEventListener("change", onFocusSeriesChange);
    }

    function onViewChange(event) {
      state.view = event.target.value;
      state.focusSeriesKey = "";
      syncMetricOptions();
      render();
    }

    function onMetricChange(event) {
      state.metric = event.target.value;
      state.focusSeriesKey = "";
      render();
    }

    function onPeriodChange(event) {
      state.periodKey = event.target.value;
      render();
    }

    function onTopNChange(event) {
      state.topN = Number(event.target.value);
      state.focusSeriesKey = "";
      render();
    }

    function onSearchChange(event) {
      state.search = event.target.value.trim().toLowerCase();
      state.focusSeriesKey = "";
      render();
    }

    function onFocusSeriesChange(event) {
      state.focusSeriesKey = event.target.value;
      render();
    }

    function populateViewOptions() {
      viewSelect.innerHTML = Object.entries(viewCatalog)
        .map(([key, value]) => `<option value="${key}">${value.label}</option>`)
        .join("");
      viewSelect.value = state.view;
    }

    function populatePeriodOptions() {
      periodSelect.innerHTML = report.periods
        .map(period => `<option value="${period.key}">${period.label}</option>`)
        .join("");
      periodSelect.value = state.periodKey;
    }

    function syncMetricOptions() {
      const viewData = viewCatalog[state.view].data;
      metricSelect.innerHTML = viewData.metrics
        .map(metric => `<option value="${escapeAttribute(metric.key)}" title="${escapeAttribute(metric.description || metric.label)}">${escapeHtml(metric.label)}</option>`)
        .join("");
      if (!viewData.metrics.some(metric => metric.key === state.metric)) {
        state.metric = viewData.default_metric;
      }
      metricSelect.value = state.metric;
    }

    function render() {
      const selectedPeriod = report.periods.find(period => period.key === state.periodKey);
      renderSummaryCards(selectedPeriod);
      renderDiagnostics(selectedPeriod);
      if (state.view === "period") {
        renderPeriodChart();
        renderPeriodTable();
      } else {
        renderEntityChart();
        renderEntityTable();
      }
    }

    function renderSummaryCards(selectedPeriod) {
      if (!selectedPeriod) {
        summaryCards.innerHTML = renderEmptyState(t("common.no_period_data"));
        return;
      }
      const summary = selectedPeriod.summary;
      summaryCards.innerHTML = [
        summaryCard(
          t("analysis.period"),
          selectedPeriod.label,
          `${selectedPeriod.start_date} to ${selectedPeriod.end_date}`,
          selectedPeriod
        ),
        summaryCard(metricLabelHtml("pull_request_count"), formatValue(summary.pull_request_count, "int"), `${metricLabel("merged_pull_request_count")} ${formatValue(summary.merged_pull_request_count, "int")}`),
        summaryCard(metricLabelHtml("active_author_count"), formatValue(summary.active_author_count, "int"), `${metricLabel("merged_pull_requests_per_active_author")} ${formatValue(summary.merged_pull_requests_per_active_author, "float")}`),
        summaryCard(metricLabelHtml("time_to_merge_median_hours"), formatValue(summary.time_to_merge_median_hours, "duration"), ""),
        summaryCard(metricLabelHtml("time_to_first_review_median_hours"), formatValue(summary.time_to_first_review_median_hours, "duration"), "")
      ].join("");
    }

    function summaryCard(title, value, meta, period = null) {
      const isPartial = Boolean(period?.is_partial);
      const badge = isPartial
        ? `<span class="period-badge">${periodStatusText(period)} · ${i18n.locale === "ko" ? "관측일" : "observed through"} ${period.observed_through_date}</span>`
        : "";
      return `
        <article class="summary-card ${isPartial ? "partial-period" : ""}">
          <h3>${title}</h3>
          <div class="summary-value">${value}</div>
          <div class="summary-meta">${meta}</div>
          ${badge}
        </article>
      `;
    }

    function renderDiagnostics(selectedPeriod) {
      if (!selectedPeriod) {
        diagnosticsRoot.innerHTML = renderEmptyState(t("common.no_view_data"));
        diagnosticsTitle.textContent = t("analysis.spike_diagnostics");
        return;
      }
      diagnosticsTitle.textContent = i18n.locale === "ko" ? `${selectedPeriod.label} 스파이크 진단` : `Spike diagnostics for ${selectedPeriod.label}`;
      const diagnostics = selectedPeriod.diagnostics;
      diagnosticsRoot.innerHTML = `
        <div class="diagnostic-grid">
          ${diagnosticCard(t("analysis.same_period_created", "Same-period created"), formatValue(diagnostics.same_period_created_ratio, "percent"), `${formatValue(diagnostics.same_period_created_count, "int")} ${metricLabel("pull_request_count")}`, "good")}
          ${diagnosticCard(t("analysis.older_pr_ratio", "Older PR ratio"), formatValue(diagnostics.older_pull_request_ratio, "percent"), i18n.locale === "ko" ? `${formatValue(diagnostics.older_pull_request_count, "int")}개가 이 기간으로 이월` : `${formatValue(diagnostics.older_pull_request_count, "int")} carried into this period`, "warn")}
          ${diagnosticCard(t("common.period_state"), periodStatusText(selectedPeriod), `${i18n.locale === "ko" ? "관측일" : "Observed through"} ${selectedPeriod.observed_through_date}`, selectedPeriod.is_partial ? "warn" : "good")}
        </div>
        <div class="table-stack">
          ${renderMiniTable(i18n.locale === "ko" ? "상위 기여 저장소" : "Top contributing repositories", diagnostics.top_contributing_repositories, [
            { key: "label", label: t("common.repository") },
            { key: "pull_request_count", label: metricLabelHtml("pull_request_count"), format: "int" },
            { key: "share", label: metricLabelHtml("repository_share"), format: "percent" }
          ])}
          ${renderMiniTable(i18n.locale === "ko" ? "상위 업데이트 날짜" : "Top updated dates", diagnostics.top_updated_dates, [
            { key: "label", label: i18n.locale === "ko" ? "날짜" : "Date" },
            { key: "count", label: metricLabelHtml("pull_request_count"), format: "int" },
            { key: "share", label: metricLabelHtml("repository_share"), format: "percent" }
          ])}
          ${renderMiniTable(i18n.locale === "ko" ? "타임라인 이벤트 분석" : "Timeline event breakdown", diagnostics.timeline_event_breakdown, [
            { key: "label", label: i18n.locale === "ko" ? "이벤트" : "Event" },
            { key: "event_count", label: i18n.locale === "ko" ? "이벤트 수" : "Events", format: "int" },
            { key: "pull_request_count", label: metricLabelHtml("pull_request_count"), format: "int" },
            { key: "share", label: metricLabelHtml("repository_share"), format: "percent" }
          ])}
        </div>
      `;
    }

    function diagnosticCard(title, value, meta, tone) {
      const toneClass = tone === "warn" ? "warn" : "";
      return `
        <article class="diagnostic-card ${toneClass}">
          <h3>${title}</h3>
          <div class="diagnostic-value">${value}</div>
          <p>${meta}</p>
        </article>
      `;
    }

    function renderMiniTable(title, rows, columns) {
      if (!rows.length) {
        return `
          <section>
            <h3 class="section-title">${title}</h3>
            ${renderEmptyState(i18n.locale === "ko" ? "행이 없습니다." : "No rows available.")}
          </section>
        `;
      }
      const headers = columns.map(column => `<th>${column.label}</th>`).join("");
      const body = rows.map(row => `
        <tr class="${row.is_partial || String(row.state || "").startsWith("open") ? "partial-period-row" : ""}">
          ${columns.map(column => `<td>${formatValue(row[column.key], column.format ?? "text")}</td>`).join("")}
        </tr>
      `).join("");
      return `
        <section>
          <h3 class="section-title">${title}</h3>
          <table class="mini-table">
            <thead><tr>${headers}</tr></thead>
            <tbody>${body}</tbody>
          </table>
        </section>
      `;
    }

    function renderPeriodChart() {
      const periodView = viewCatalog.period.data;
      const metric = metricDefinition(periodView.metrics, state.metric);
      chartTitle.textContent = i18n.locale === "ko" ? `기간별 ${metric.label}` : `${metric.label} by period`;
      chartCaption.textContent = i18n.locale === "ko" ? "선택한 지표의 조직 전체 추세입니다." : "Matched org-wide trend for the selected metric.";
      chartRoot.innerHTML = lineChart([
        {
          label: metric.label,
          color: palette[0],
          points: periodView.periods.map(period => ({
            label: period.label,
            value: period.values[state.metric],
            isPartial: period.is_partial,
            statusText: periodStatusText(period)
          }))
        }
      ], metric.format);
      chartLegend.innerHTML = `<span class="legend-chip" title="${escapeAttribute(metric.description || metric.label)}"><span class="legend-swatch" style="background:${palette[0]}"></span>${escapeHtml(metric.label)}</span>`;
      focusSeriesSelect.innerHTML = `<option value="">${i18n.locale === "ko" ? "해당 없음" : "Not applicable"}</option>`;
      focusSeriesSelect.disabled = true;
    }

    function renderEntityChart() {
      const viewData = viewCatalog[state.view].data;
      const metric = metricDefinition(viewData.metrics, state.metric);
      const entities = rankedEntities(viewData.entities, state.metric);
      const focusedEntities = state.focusSeriesKey
        ? entities.filter(entity => entity.key === state.focusSeriesKey)
        : entities;
      const chartEntities = focusedEntities.slice(0, state.focusSeriesKey ? focusedEntities.length : state.topN);
      chartTitle.textContent = i18n.locale === "ko" ? `${viewCatalog[state.view].label}별 ${metric.label}` : `${metric.label} by ${viewCatalog[state.view].label.toLowerCase()}`;
      chartCaption.textContent = i18n.locale === "ko" ? `${viewData.periods.length}개 기간의 상위 ${chartEntities.length}개 시리즈입니다.` : `Top ${chartEntities.length} series across ${viewData.periods.length} periods.`;
      chartRoot.innerHTML = chartEntities.length
        ? lineChart(chartEntities.map((entity, index) => ({
            key: entity.key,
            label: entity.label,
            color: palette[index % palette.length],
            points: entity.period_values.map(periodValue => ({
              label: periodValue.label,
              value: periodValue.values[state.metric],
              isPartial: periodValue.is_partial,
              statusText: periodStatusText(periodValue)
            }))
          })), metric.format)
        : renderEmptyState(i18n.locale === "ko" ? "현재 필터와 일치하는 시리즈가 없습니다." : "No matching series for the current filter.");
      chartLegend.innerHTML = chartEntities.map((entity, index) => `
        <button type="button" class="legend-chip" data-entity-key="${entity.key}">
          <span class="legend-swatch" style="background:${palette[index % palette.length]}"></span>
          ${entity.label}
        </button>
      `).join("");
      chartLegend.querySelectorAll("[data-entity-key]").forEach(button => {
        button.addEventListener("click", () => {
          const entityKey = button.getAttribute("data-entity-key");
          state.focusSeriesKey = state.focusSeriesKey === entityKey ? "" : entityKey;
          focusSeriesSelect.value = state.focusSeriesKey;
          render();
        });
      });
      focusSeriesSelect.disabled = false;
      focusSeriesSelect.innerHTML = [`<option value="">${i18n.locale === "ko" ? "표시된 모든 시리즈" : "All visible series"}</option>`]
        .concat(entities.map(entity => `<option value="${escapeAttribute(entity.key)}">${escapeHtml(entity.label)}</option>`))
        .join("");
      focusSeriesSelect.value = state.focusSeriesKey;
    }

    function renderPeriodTable() {
      const periodView = viewCatalog.period.data;
      const metric = metricDefinition(periodView.metrics, state.metric);
      tableTitle.textContent = i18n.locale === "ko" ? `기간별 ${metric.label}` : `${metric.label} across periods`;
      tableRoot.innerHTML = renderMiniTable(i18n.locale === "ko" ? "기간" : "Periods", periodView.periods.map(period => ({
        label: period.label,
        start_date: period.start_date,
        end_date: period.end_date,
        state: periodStatusText(period),
        is_partial: period.is_partial,
        value: period.values[state.metric]
      })), [
        { key: "label", label: t("analysis.period") },
        { key: "start_date", label: i18n.locale === "ko" ? "시작" : "Start" },
        { key: "end_date", label: i18n.locale === "ko" ? "종료" : "End" },
        { key: "state", label: t("common.state") },
        { key: "value", label: metricLabelHtml(metric.key, metric.label, metric.description), format: metric.format }
      ]);
    }

    function renderEntityTable() {
      const viewData = viewCatalog[state.view].data;
      const metric = metricDefinition(viewData.metrics, state.metric);
      const rows = rankedEntitiesForPeriod(viewData.entities, state.metric, state.periodKey)
        .slice(0, state.topN);
      tableTitle.textContent = i18n.locale === "ko" ? `${state.periodKey} ${viewCatalog[state.view].label} 순위` : `${viewCatalog[state.view].label} ranking for ${state.periodKey}`;
      tableRoot.innerHTML = renderMiniTable(i18n.locale === "ko" ? `상위 ${viewCatalog[state.view].label}` : `Top ${viewCatalog[state.view].label.toLowerCase()}s`, rows, [
        { key: "label", label: viewCatalog[state.view].label },
        { key: "value", label: `${t("common.selected_period")} ${metricLabelHtml(metric.key, metric.label, metric.description)}`, format: metric.format },
        { key: "total", label: i18n.locale === "ko" ? `전체 기간 ${metricLabelHtml(metric.key, metric.label, metric.description)}` : `All-period ${metricLabelHtml(metric.key, metric.label, metric.description)}`, format: metric.format }
      ]);
    }

    function rankedEntitiesForPeriod(entities, metricKey, periodKey) {
      return rankedEntities(entities, metricKey)
        .map(entity => {
          const periodValue = entity.period_values.find(period => period.key === periodKey);
          return {
            label: entity.label,
            value: periodValue?.values[metricKey] ?? null,
            total: entity.totals[metricKey]
          };
        })
        .filter(row => row.value !== null)
        .sort((left, right) => {
          const leftValue = Number(left.value ?? 0);
          const rightValue = Number(right.value ?? 0);
          if (rightValue !== leftValue) {
            return rightValue - leftValue;
          }
          const leftTotal = Number(left.total ?? 0);
          const rightTotal = Number(right.total ?? 0);
          if (rightTotal !== leftTotal) {
            return rightTotal - leftTotal;
          }
          return left.label.localeCompare(right.label);
        });
    }

    function rankedEntities(entities, metricKey) {
      return entities
        .filter(entity => !state.search || entity.label.toLowerCase().includes(state.search))
        .sort((left, right) => {
          const leftTotal = Number(left.totals[metricKey] ?? 0);
          const rightTotal = Number(right.totals[metricKey] ?? 0);
          if (rightTotal !== leftTotal) {
            return rightTotal - leftTotal;
          }
          return left.label.localeCompare(right.label);
        });
    }

    function metricDefinition(metrics, metricKey) {
      return metrics.find(metric => metric.key === metricKey) ?? metrics[0];
    }

    function lineChart(seriesList, format) {
      const allValues = seriesList.flatMap(series => series.points.map(point => point.value).filter(value => value !== null && value !== undefined));
      if (!allValues.length) {
        return renderEmptyState(t("common.no_metric_data"));
      }
      const width = 960;
      const height = 320;
      const padding = { top: 18, right: 20, bottom: 40, left: 48 };
      const innerWidth = width - padding.left - padding.right;
      const innerHeight = height - padding.top - padding.bottom;
      const maxValue = Math.max(...allValues.map(value => Number(value)));
      const minValue = Math.min(...allValues.map(value => Number(value)));
      const baseline = minValue < 0 ? minValue : 0;
      const range = Math.max(maxValue - baseline, 1);
      const xFor = index => padding.left + (seriesList[0].points.length === 1 ? innerWidth / 2 : (innerWidth * index) / (seriesList[0].points.length - 1));
      const yFor = value => padding.top + innerHeight - ((Number(value) - baseline) / range) * innerHeight;
      const axisTicks = Array.from({ length: 4 }, (_, index) => baseline + (range * index) / 3);
      const partialBands = seriesList[0].points.map((point, index) => {
        if (!point.isPartial) {
          return "";
        }
        const previousX = index === 0 ? padding.left : xFor(index - 1);
        const nextX = index === seriesList[0].points.length - 1 ? width - padding.right : xFor(index + 1);
        const bandWidth = Math.max(12, (nextX - previousX) / 2);
        return `<rect class="partial-period-band" x="${xFor(index) - bandWidth / 2}" y="${padding.top}" width="${bandWidth}" height="${innerHeight}" rx="8" />`;
      }).join("");

      const gridLines = axisTicks.map(tick => {
        const y = yFor(tick);
        return `
          <line x1="${padding.left}" x2="${width - padding.right}" y1="${y}" y2="${y}" stroke="rgba(31,43,42,0.08)" />
          <text x="${padding.left - 10}" y="${y + 4}" text-anchor="end" class="axis-label">${formatValue(tick, format)}</text>
        `;
      }).join("");

      const labels = seriesList[0].points.map((point, index) => `
        <text x="${xFor(index)}" y="${height - 10}" text-anchor="middle" class="axis-label">${point.label}</text>
      `).join("");

      const lines = seriesList.map(series => {
        const path = series.points
          .map((point, index) => `${index === 0 ? "M" : "L"} ${xFor(index)} ${yFor(point.value ?? baseline)}`)
          .join(" ");
        const markers = series.points.map((point, index) => `
          <circle class="${point.isPartial ? "partial-period-marker" : ""}" cx="${xFor(index)}" cy="${yFor(point.value ?? baseline)}" r="${point.isPartial ? 5 : 4}" fill="${series.color}">
            <title>${point.label}: ${formatValue(point.value, format)}${point.isPartial ? ` (${point.statusText})` : ""}</title>
          </circle>
        `).join("");
        return `
          <path d="${path}" fill="none" stroke="${series.color}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
          ${markers}
        `;
      }).join("");

      return `
        <svg viewBox="0 0 ${width} ${height}" width="100%" height="${height}" role="img" aria-label="${i18n.locale === "ko" ? "선 그래프" : "Line chart"}">
          ${partialBands}
          ${gridLines}
          ${lines}
          ${labels}
        </svg>
      `;
    }

    function periodStatusText(period) {
      if (!period) {
        return "unknown period";
      }
      if (period.state_label) {
        return period.state_label;
      }
      return period.status || "closed";
    }

    function renderEmptyState(message) {
      return `<div class="empty-state">${message}</div>`;
    }

    function formatValue(value, format) {
      if (value === null || value === undefined || Number.isNaN(Number(value))) {
        return "n/a";
      }
      if (format === "duration") {
        return formatDuration(Number(value));
      }
      if (format === "int") {
        return Intl.NumberFormat(i18n.locale === "ko" ? "ko-KR" : "en-US", { maximumFractionDigits: 0 }).format(Number(value));
      }
      if (format === "percent") {
        return Intl.NumberFormat(i18n.locale === "ko" ? "ko-KR" : "en-US", { style: "percent", maximumFractionDigits: 1 }).format(Number(value));
      }
      if (format === "float") {
        return Intl.NumberFormat(i18n.locale === "ko" ? "ko-KR" : "en-US", { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(Number(value));
      }
      return String(value);
    }

    function t(key, fallback = null) {
      return i18n.static[key] || fallback || key;
    }

    function metricLabel(metricKey, fallback = null) {
      return i18n.metrics[metricKey]?.label || fallback || metricKey;
    }

    function metricDescription(metricKey, fallback = null) {
      return i18n.metrics[metricKey]?.description || fallback || metricLabel(metricKey);
    }

    function metricLabelHtml(metricKey, fallback = null, description = null) {
      const label = fallback || metricLabel(metricKey);
      const tooltip = description || metricDescription(metricKey, label);
      return `<span class="metric-label-with-tooltip"><span>${escapeHtml(label)}</span><span class="metric-tooltip" tabindex="0" role="note" title="${escapeAttribute(tooltip)}" aria-label="${escapeAttribute(tooltip)}">?</span></span>`;
    }

    function formatDuration(hours) {
      if (hours < 1) {
        return `${Intl.NumberFormat(i18n.locale === "ko" ? "ko-KR" : "en-US").format(Math.round(hours * 60))}${i18n.locale === "ko" ? "분" : " min"}`;
      }
      if (hours >= 24) {
        return `${Intl.NumberFormat(i18n.locale === "ko" ? "ko-KR" : "en-US", { maximumFractionDigits: 1 }).format(hours / 24)}${i18n.locale === "ko" ? "일" : " d"}`;
      }
      return `${Intl.NumberFormat(i18n.locale === "ko" ? "ko-KR" : "en-US", { maximumFractionDigits: 1 }).format(hours)}${i18n.locale === "ko" ? "시간" : " h"}`;
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, character => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      }[character]));
    }

    function escapeAttribute(value) {
      return escapeHtml(value);
    }
  </script>
