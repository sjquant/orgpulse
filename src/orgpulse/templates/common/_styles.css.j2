  <style>
    :root {
      color-scheme: dark;
      --font-sans: "Inter", "Aptos", "IBM Plex Sans", "Helvetica Neue", sans-serif;
      --font-display: "Space Grotesk", "Inter", "IBM Plex Sans", sans-serif;
      --font-mono: "IBM Plex Mono", "SFMono-Regular", monospace;
      --radius-panel: 8px;
      --radius-control: 6px;
      --radius-pill: 999px;
      --bg-canvas: #080a14;
      --bg-canvas-top: #11182d;
      --bg-glow: rgba(88, 166, 255, 0.11);
      --bg-section-nav: rgba(9, 14, 30, 0.82);
      --panel-raised: #101727;
      --panel-elevated: #151f33;
      --panel-subtle: rgba(255, 255, 255, 0.052);
      --panel-muted: rgba(255, 255, 255, 0.032);
      --line: rgba(135, 157, 196, 0.24);
      --line-strong: rgba(155, 181, 224, 0.42);
      --line-soft: rgba(255, 255, 255, 0.095);
      --line-faint: rgba(255, 255, 255, 0.055);
      --text: #f4f7ff;
      --muted: #a5b4d5;
      --accent: #58a6ff;
      --accent-2: #39d6c0;
      --accent-3: #ffb454;
      --accent-4: #d86cff;
      --danger: #ff8b8b;
      --positive: #7ee0b3;
      --negative: #ff8b8b;
      --track: rgba(255, 255, 255, 0.075);
      --active-fill: rgba(88, 166, 255, 0.16);
      --readout-fill: rgba(88, 166, 255, 0.09);
      --readout-border: rgba(88, 166, 255, 0.3);
      --grid-stroke: rgba(255, 255, 255, 0.085);
      --avg-stroke: rgba(126, 224, 179, 0.4);
      --theme-toggle-bg: rgba(255, 255, 255, 0.02);
      --theme-toggle-active: rgba(88, 166, 255, 0.2);
      --theme-toggle-hover: rgba(88, 166, 255, 0.11);
      --theme-toggle-indicator-shadow: 0 8px 18px rgba(4, 10, 18, 0.22);
      --tooltip-bg: #e8edf7;
      --tooltip-text: #070b12;
      --shadow: 0 1px 1px rgba(0, 0, 0, 0.3), 0 22px 60px rgba(0, 0, 0, 0.32);
      --shadow-tight: 0 1px 1px rgba(0, 0, 0, 0.2), 0 14px 34px rgba(0, 0, 0, 0.18);
      --shadow-glow: 0 0 0 1px rgba(88, 166, 255, 0.08), 0 24px 80px rgba(20, 96, 190, 0.18);
    }

    :root[data-theme="light"] {
      color-scheme: light;
      --bg-canvas: #eef4fb;
      --bg-canvas-top: #fbfdff;
      --bg-glow: rgba(37, 103, 176, 0.11);
      --bg-section-nav: rgba(252, 254, 255, 0.86);
      --panel-raised: #ffffff;
      --panel-elevated: #f7faff;
      --panel-subtle: rgba(22, 41, 73, 0.045);
      --panel-muted: rgba(22, 41, 73, 0.028);
      --line: rgba(91, 119, 156, 0.24);
      --line-strong: rgba(72, 103, 148, 0.36);
      --line-soft: rgba(85, 109, 138, 0.16);
      --line-faint: rgba(85, 109, 138, 0.1);
      --text: #111827;
      --muted: #52667f;
      --accent: #246bfe;
      --accent-2: #008f83;
      --accent-3: #b86a00;
      --accent-4: #8b42e8;
      --danger: #c04444;
      --positive: #187e59;
      --negative: #be4848;
      --track: rgba(85, 109, 138, 0.14);
      --active-fill: rgba(36, 107, 254, 0.1);
      --readout-fill: rgba(36, 107, 254, 0.07);
      --readout-border: rgba(36, 107, 254, 0.22);
      --grid-stroke: rgba(85, 109, 138, 0.15);
      --avg-stroke: rgba(28, 143, 104, 0.35);
      --theme-toggle-bg: rgba(14, 22, 37, 0.03);
      --theme-toggle-active: rgba(37, 103, 176, 0.12);
      --theme-toggle-hover: rgba(37, 103, 176, 0.08);
      --theme-toggle-indicator-shadow: 0 10px 18px rgba(80, 111, 152, 0.16);
      --tooltip-bg: #0f1b2d;
      --tooltip-text: #f8fbff;
      --shadow: 0 1px 2px rgba(26, 40, 65, 0.05), 0 24px 60px rgba(29, 55, 99, 0.14);
      --shadow-tight: 0 1px 2px rgba(26, 40, 65, 0.06), 0 12px 34px rgba(29, 55, 99, 0.09);
      --shadow-glow: 0 0 0 1px rgba(36, 107, 254, 0.08), 0 24px 80px rgba(36, 107, 254, 0.14);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      background:
        linear-gradient(135deg, rgba(88, 166, 255, 0.16) 0 9%, transparent 9% 34%, rgba(216, 108, 255, 0.07) 34% 45%, transparent 45% 100%),
        linear-gradient(165deg, transparent 0 54%, rgba(57, 214, 192, 0.07) 54% 63%, transparent 63% 100%),
        linear-gradient(180deg, var(--bg-glow), transparent 300px),
        linear-gradient(180deg, var(--bg-canvas-top) 0%, var(--bg-canvas) 100%);
      color: var(--text);
      font-family: var(--font-sans);
      font-feature-settings: "cv02", "cv03", "cv04", "tnum";
    }

    html {
      overflow-x: hidden;
      scroll-behavior: smooth;
    }

    body { padding: 32px 24px 44px; }

    .report {
      max-width: 1440px;
      margin: 0 auto;
    }

    .report__hero {
      display: grid;
      gap: 20px;
      align-items: start;
      margin-bottom: 20px;
    }

    .report__panel {
      position: relative;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent 48%),
        var(--panel-raised);
      border: 1px solid var(--line);
      border-radius: var(--radius-panel);
      box-shadow: var(--shadow);
      min-width: 0;
    }

    .report__hero-panel,
    .report__insight-panel {
      padding: 28px;
    }

    .report__section-panel {
      padding: 34px 28px 32px;
    }

    .report__hero-panel {
      min-height: 260px;
      overflow: hidden;
      background:
        linear-gradient(115deg, color-mix(in srgb, var(--accent) 18%, transparent), transparent 36%),
        linear-gradient(155deg, transparent 0 52%, color-mix(in srgb, var(--accent-4) 14%, transparent) 52% 64%, transparent 64% 100%),
        var(--panel-raised);
      box-shadow: var(--shadow-glow);
      isolation: isolate;
    }

    .report__hero-panel::before,
    .report__hero-panel::after {
      position: absolute;
      content: "";
      pointer-events: none;
    }

    .report__hero-panel::before {
      inset: 0;
      z-index: -1;
      background:
        linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent),
        repeating-linear-gradient(90deg, transparent 0 42px, rgba(255, 255, 255, 0.045) 42px 43px),
        repeating-linear-gradient(0deg, transparent 0 42px, rgba(255, 255, 255, 0.035) 42px 43px);
      mask-image: linear-gradient(110deg, transparent 0%, black 40%, black 78%, transparent 100%);
      opacity: 0.7;
    }

    .report__hero-panel::after {
      right: clamp(18px, 5vw, 72px);
      bottom: -34px;
      width: min(430px, 45%);
      height: 188px;
      border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
      border-radius: var(--radius-panel);
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--accent) 58%, transparent) 0 18%, transparent 18% 100%),
        linear-gradient(180deg, color-mix(in srgb, var(--accent-2) 22%, transparent), transparent 44%),
        linear-gradient(135deg, rgba(255, 255, 255, 0.12), transparent 45%),
        color-mix(in srgb, var(--panel-elevated) 78%, transparent);
      box-shadow: 0 28px 80px rgba(0, 0, 0, 0.28);
      transform: perspective(650px) rotateX(54deg) rotateZ(-9deg);
      transform-origin: 100% 100%;
      opacity: 0.78;
    }

    .report__section-panel {
      box-shadow: var(--shadow-tight);
    }

    .report__eyebrow,
    .report__section-kicker {
      margin: 0 0 12px;
      color: color-mix(in srgb, var(--accent) 82%, var(--accent-2) 18%);
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 700;
    }

    h1, h2, h3, p { margin-top: 0; }

    h1 {
      margin-bottom: 12px;
      max-width: 980px;
      font-size: clamp(2.5rem, 5vw, 5.35rem);
      line-height: 0.94;
      letter-spacing: 0;
      font-family: var(--font-display);
    }

    h2 {
      margin-bottom: 12px;
      font-size: clamp(1.35rem, 1.6vw, 1.85rem);
      letter-spacing: 0;
      font-family: var(--font-display);
    }

    .report__subtitle,
    .report__section-copy,
    .report__insight-card p,
    .report__table-footnote {
      color: var(--muted);
      line-height: 1.58;
    }

    .report__hero-meta {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin-top: 30px;
    }

    .report__hero-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      gap: 16px;
      position: relative;
      z-index: 1;
    }

    .report__hero-copy {
      min-width: 0;
      max-width: 980px;
    }

    .report__theme-switch {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-control);
      background: color-mix(in srgb, var(--panel-elevated) 72%, transparent);
      flex-shrink: 0;
      isolation: isolate;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .report__theme-switch-indicator {
      position: absolute;
      top: 4px;
      left: 4px;
      width: 36px;
      height: 36px;
      border-radius: 4px;
      background: var(--theme-toggle-active);
      box-shadow: var(--theme-toggle-indicator-shadow), inset 0 1px 0 rgba(255, 255, 255, 0.12);
      transition:
        transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
        background 160ms ease,
        box-shadow 180ms ease;
      z-index: 0;
      pointer-events: none;
    }

    .report__theme-switch[data-active-theme="light"] .report__theme-switch-indicator {
      transform: translateX(40px);
    }

    .report__theme-switch-button {
      border: 0;
      background: transparent;
      color: var(--muted);
      border-radius: 4px;
      width: 36px;
      height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      cursor: pointer;
      position: relative;
      z-index: 1;
      transition:
        color 160ms ease,
        background 160ms ease,
        transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .report__theme-switch-button:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.04);
      transform: translateY(-1px);
    }

    .report__theme-switch-button[aria-pressed="true"] {
      color: var(--text);
    }

    .report__theme-switch-icon {
      width: 18px;
      height: 18px;
      display: block;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition:
        transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
        opacity 160ms ease;
    }

    .report__theme-switch-button[aria-pressed="true"] .report__theme-switch-icon {
      transform: scale(1.04);
    }

    .report__theme-switch-button[data-theme-option="light"]:hover .report__theme-switch-icon,
    .report__theme-switch-button[data-theme-option="light"][aria-pressed="true"] .report__theme-switch-icon {
      transform: rotate(12deg) scale(1.04);
    }

    .report__theme-switch-button[data-theme-option="dark"]:hover .report__theme-switch-icon,
    .report__theme-switch-button[data-theme-option="dark"][aria-pressed="true"] .report__theme-switch-icon {
      transform: rotate(-10deg) scale(1.04);
    }

    .report__meta-box,
    .report__stat-card {
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 58%),
        var(--panel-elevated);
      border: 1px solid var(--line);
      border-radius: var(--radius-control);
      padding: 15px 16px;
    }

    .report__meta-box {
      position: relative;
      z-index: 1;
      overflow: hidden;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.07), transparent 65%),
        color-mix(in srgb, var(--panel-elevated) 82%, transparent);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .report__meta-box::before {
      position: absolute;
      inset: 0 auto 0 0;
      width: 3px;
      content: "";
      background: linear-gradient(180deg, var(--accent), var(--accent-2));
    }

    .report__meta-label,
    .report__stat-label {
      display: block;
      margin-bottom: 6px;
      color: var(--muted);
      font-size: 0.68rem;
      letter-spacing: 0.11em;
      text-transform: uppercase;
      font-weight: 700;
    }

    .report__metric-label {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      min-width: 0;
      vertical-align: middle;
    }

    .report__metric-tooltip {
      position: relative;
      z-index: 20;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 16px;
      height: 16px;
      border-radius: 999px;
      border: 1px solid var(--line-strong);
      color: var(--accent);
      font-size: 0.7rem;
      font-weight: 800;
      line-height: 1;
      cursor: help;
    }

    .report__legend-chip[data-tooltip]:not([data-tooltip=""]) {
      position: relative;
      z-index: 20;
      cursor: help;
    }

    .report__metric-tooltip::after,
    .report__legend-chip[data-tooltip]:not([data-tooltip=""])::after {
      display: none;
      position: absolute;
      left: 50%;
      z-index: 10000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 120ms ease, transform 120ms ease;
      content: attr(data-tooltip);
      bottom: calc(100% + 8px);
      width: max-content;
      max-width: min(280px, 70vw);
      padding: 8px 10px;
      border: 1px solid var(--line-strong);
      border-radius: 6px;
      background: var(--tooltip-bg);
      color: var(--tooltip-text);
      box-shadow: var(--shadow);
      font-size: 0.76rem;
      font-weight: 650;
      line-height: 1.35;
      text-align: left;
      text-transform: none;
      white-space: normal;
      transform: translate(-50%, 4px);
    }

    .report__metric-tooltip:hover::after,
    .report__metric-tooltip:focus::after,
    .report__legend-chip[data-tooltip]:not([data-tooltip=""]):hover::after,
    .report__legend-chip[data-tooltip]:not([data-tooltip=""]):focus::after {
      display: block;
      opacity: 1;
      transform: translate(-50%, 0);
    }

    .report__metric-tooltip:hover,
    .report__metric-tooltip:focus,
    .report__legend-chip[data-tooltip]:not([data-tooltip=""]):hover,
    .report__legend-chip[data-tooltip]:not([data-tooltip=""]):focus {
      z-index: 10001;
    }

    .report__metric-tooltip:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .report__meta-value {
      font-size: 0.98rem;
      font-weight: 760;
      overflow-wrap: anywhere;
    }

    .report__section-nav {
      position: sticky;
      top: 0;
      z-index: 5;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
      padding: 11px;
      border: 1px solid var(--line);
      border-radius: var(--radius-panel);
      background: var(--bg-section-nav);
      backdrop-filter: blur(14px);
      box-shadow: var(--shadow-tight);
    }

    .report__section-nav a {
      color: var(--muted);
      text-decoration: none;
      border: 1px solid transparent;
      border-radius: var(--radius-pill);
      padding: 8px 13px;
      font-size: 0.82rem;
      font-weight: 700;
      transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease, transform 140ms ease;
    }

    .report__section-nav a[aria-current="true"] {
      color: var(--text);
      border-color: var(--accent);
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--accent) 18%, transparent), color-mix(in srgb, var(--accent-2) 12%, transparent));
      box-shadow: inset 0 0 0 1px rgba(117, 199, 255, 0.14), 0 8px 20px rgba(37, 103, 176, 0.12);
    }

    .report__section-nav a:hover,
    .report__section-nav a:focus-visible {
      color: var(--text);
      border-color: var(--accent);
      background: var(--theme-toggle-hover);
      outline: none;
      transform: translateY(-1px);
    }

    .report__insight-panel {
      margin-bottom: 16px;
    }

    .report__insight-list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
    }

    .report__insight-card {
      border: 1px solid var(--line);
      border-left: 3px solid var(--accent);
      border-radius: var(--radius-control);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent 60%),
        var(--panel-subtle);
      padding: 14px 14px 14px 16px;
    }

    .report__insight-card h3 {
      margin-bottom: 6px;
      font-size: 0.92rem;
    }

    .report__stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
      gap: 14px;
      margin-bottom: 20px;
    }

    .report__stat-card {
      position: relative;
      overflow: hidden;
      border-color: color-mix(in srgb, var(--line) 76%, var(--accent) 24%);
      box-shadow: var(--shadow-tight);
      min-height: 156px;
    }

    .report__stat-card::before {
      position: absolute;
      inset: 0 0 auto;
      height: 3px;
      content: "";
      background: linear-gradient(90deg, var(--accent), var(--accent-2), var(--accent-4));
    }

    .report__stat-value {
      position: relative;
      z-index: 1;
      font-size: clamp(2.15rem, 3vw, 3.15rem);
      line-height: 1;
      font-weight: 800;
      font-family: var(--font-display);
    }

    .report__stat-subvalue {
      margin-top: 8px;
      position: relative;
      z-index: 1;
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.45;
    }

    .report__section-grid {
      display: grid;
      gap: 28px;
    }

    .report__section-grid > *,
    .report__wide-stack,
    .person-report__chart-panel {
      min-width: 0;
      max-width: 100%;
    }

    .report__section-grid > section,
    .report__section-grid > .report__wide-stack > article {
      scroll-margin-top: 82px;
    }

    .person-report__chart-panel {
      display: grid;
      gap: 16px;
    }

    .report__tab-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .report__tab-strip.report__tab-strip--primary {
      gap: 10px;
      padding: 5px;
      border: 1px solid var(--line);
      border-radius: var(--radius-control);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.055), transparent),
        var(--panel-elevated);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .report__tab-strip.report__tab-strip--secondary,
    .org-dashboard__detail-tabs.report__tab-strip--secondary {
      gap: 6px;
      width: fit-content;
      max-width: 100%;
      align-items: center;
    }

    .org-dashboard__detail-tabs.report__tab-strip--tertiary {
      gap: 6px;
      padding-left: 8px;
      border-left: 2px solid var(--line);
    }

    .report__tab-button {
      border: 1px solid var(--line);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.045), transparent),
        var(--panel-raised);
      color: var(--muted);
      border-radius: var(--radius-control);
      padding: 8px 12px;
      font: inherit;
      cursor: pointer;
      transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease, transform 140ms ease, box-shadow 140ms ease;
    }

    .report__tab-strip--primary .report__tab-button {
      padding: 9px 14px;
      font-weight: 800;
      color: var(--text);
      background: color-mix(in srgb, var(--panel-raised) 76%, var(--active-fill) 24%);
    }

    .report__tab-strip--secondary .report__tab-button {
      padding: 7px 11px;
      font-size: 0.88rem;
    }

    .report__tab-strip--tertiary .report__tab-button {
      padding: 6px 9px;
      font-size: 0.8rem;
      border-color: var(--line);
      background: transparent;
    }

    .report__tab-button--active {
      color: var(--text);
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--accent) 18%, transparent), color-mix(in srgb, var(--accent-2) 10%, transparent));
      border-color: var(--accent);
      box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 16%, transparent);
    }

    .report__tab-button:hover:not(.report__tab-button--active) {
      color: var(--text);
      background: var(--theme-toggle-hover);
      border-color: var(--accent);
      transform: translateY(-1px);
    }

    .report__tab-strip--tertiary .report__tab-button--active {
      border-color: color-mix(in srgb, var(--accent-2) 70%, var(--line) 30%);
      background: color-mix(in srgb, var(--accent-2) 12%, transparent);
    }

    .report__tab-button:focus-visible,
    .report__theme-switch-button:focus-visible,
    .report__ghost-button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .report__chart-root {
      position: relative;
      border: 1px solid color-mix(in srgb, var(--line) 72%, var(--accent) 28%);
      border-radius: var(--radius-control);
      padding: 14px;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 55%),
        repeating-linear-gradient(90deg, transparent 0 48px, rgba(255, 255, 255, 0.03) 48px 49px),
        var(--panel-elevated);
      aspect-ratio: 16 / 6;
      min-height: 280px;
      max-width: 100%;
      overflow: hidden;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), var(--shadow-tight);
    }

    .report__chart-root svg {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 0;
      overflow: visible;
    }

    .report__chart-node {
      cursor: pointer;
    }

    .report__chart-tooltip {
      position: absolute;
      left: 0;
      top: 0;
      min-width: 148px;
      max-width: min(220px, calc(100% - 20px));
      padding: 9px 10px;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-control);
      background: color-mix(in srgb, var(--panel-raised) 94%, black 6%);
