<body>
  <div class="shell">
    <section class="hero">
      <div class="panel hero-panel">
        <div class="hero-head">
          <div class="hero-copy">
            <p class="eyebrow">{{ t("dashboard.eyebrow") }}</p>
            <h1>{{ overview.org }} {{ t("dashboard.heading_suffix") }}</h1>
            <p class="subtitle">{{ t("dashboard.subtitle") }}</p>
          </div>
          <div class="theme-switch" role="group" aria-label="{{ t("theme.color") }}">
            <span class="theme-switch-indicator" aria-hidden="true"></span>
            <button type="button" class="theme-switch-button" data-theme-option="dark" aria-label="{{ t("theme.dark") }}" aria-pressed="false" title="{{ t("theme.dark") }}">
              <svg class="theme-switch-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 1 0 9.8 9.8Z"></path>
              </svg>
            </button>
            <button type="button" class="theme-switch-button" data-theme-option="light" aria-label="{{ t("theme.light") }}" aria-pressed="false" title="{{ t("theme.light") }}">
              <svg class="theme-switch-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4.1"></circle>
                <path d="M12 2.75v2.35"></path>
                <path d="M12 18.9v2.35"></path>
                <path d="M21.25 12h-2.35"></path>
                <path d="M5.1 12H2.75"></path>
                <path d="m18.55 5.45-1.66 1.66"></path>
                <path d="m7.11 16.89-1.66 1.66"></path>
                <path d="m18.55 18.55-1.66-1.66"></path>
                <path d="m7.11 7.11-1.66-1.66"></path>
              </svg>
            </button>
          </div>
        </div>
        <div class="hero-meta">
          <div class="meta-box">
            <span class="meta-label">{{ t("common.window") }}</span>
            <span class="meta-value">{{ overview.since }} {{ t("common.to") }} {{ overview.until }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">{{ metric_label("stale_open_pull_requests") }}</span>
            <span class="meta-value">{{ overview.stale_open_pull_requests | intfmt }} {{ t("metric.stale_open_prs") }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">{{ metric_label("review_sla_24h_pct") }}</span>
            <span class="meta-value">{{ overview.review_sla_24h_pct | numfmt }}% {{ t("metric.within_24h") }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">{{ t("common.open_period_label") }}</span>
            <span class="meta-value">
              {% if overview.open_month %}{{ overview.open_month_key }} {{ t("common.open_month") }}{% elif overview.open_week %}{{ overview.open_week_key }} {{ t("common.open_week") }}{% else %}{{ t("common.closed_window") }}{% endif %}
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="stats-grid">
      <article class="stat-card">
        <span class="stat-label">{{ metric_label("pull_requests") }}</span>
        <div class="stat-value">{{ overview.pull_requests | intfmt }}</div>
        <div class="stat-subvalue">{{ overview.merged_pull_requests | intfmt }} {{ t("metric.merged") }} / {{ overview.open_pull_requests | intfmt }} {{ t("metric.open") }}</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">{{ metric_label("review_coverage_pct") }}</span>
        <div class="stat-value">{{ overview.review_coverage_pct }}%</div>
        <div class="stat-subvalue">{{ overview.review_submissions | intfmt }} {{ t("metric.total_review_submissions") }}</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">{{ metric_label("median_approval_hours") }}</span>
        <div class="stat-value">{{ overview.median_approval_hours | duration }}</div>
        <div class="stat-subvalue">{{ t("metric.ready_to_approval") }}</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">{{ metric_label("median_merge_hours") }}</span>
        <div class="stat-value">{{ overview.median_merge_hours | duration }}</div>
        <div class="stat-subvalue">{{ t("metric.creation_to_merge") }}</div>
      </article>
    </section>

    <section class="summary-strip">
      <article class="summary-card panel">
        <span class="summary-label">{{ metric_label("changed_lines") }}</span>
        <strong>{{ overview.total_changed_lines | intfmt }}</strong>
        <span>{{ overview.average_changed_lines_per_pr | numfmt }} lines per PR</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">{{ metric_label("review_submissions") }}</span>
        <strong>{{ overview.unique_reviewers | intfmt }} reviewers</strong>
        <span>{{ overview.average_reviews_per_pr | numfmt }} reviews per PR</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">{{ metric_label("pull_requests_per_active_author") }}</span>
        <strong>{{ overview.pull_requests_per_active_author | numfmt }} {{ t("metric.prs") }}</strong>
        <span>{{ overview.average_active_authors_per_month | numfmt }} {{ t("metric.average_active_authors_per_month") }}</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">{{ metric_label("changed_lines_per_active_author") }}</span>
        <strong>{{ overview.changed_lines_per_active_author | numfmt }}</strong>
        <span>{{ t("metric.normalized_changed_lines_per_active_author") }}</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">{{ metric_label("review_submissions_given") }}</span>
        <strong>{{ overview.review_submissions_per_reviewer | numfmt }} {{ t("metric.reviews") }}</strong>
        <span>{{ overview.unique_reviewers | intfmt }} {{ t("metric.reviewers_in_window") }}</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">{{ metric_label("repository_share") }}</span>
        <strong>{{ reference_summary.top3_repository_share_pct | numfmt }}%</strong>
        <span>{{ t("metric.top3_repository_share") }}</span>
      </article>
    </section>

    <nav class="section-nav" aria-label="Report sections">
      <a href="#trends">{{ t("common.trends") }}</a>
      <a href="#people">{{ t("common.people") }}</a>
      <a href="#leaderboards">{{ t("common.repositories") }}</a>
      <a href="#diagnostics">{{ t("common.diagnostics") }}</a>
      <a href="#reference">{{ t("common.reference") }}</a>
    </nav>

    <div class="section-grid">
      <section id="trends" class="panel section-panel chart-panel">
        <p class="section-kicker">{{ t("common.trends") }}</p>
        <h2>{{ t("common.weekly") }} / {{ t("common.monthly") }}</h2>
        <p class="section-copy">{{ t("dashboard.trend_surface_copy") }}</p>
        <div class="two-col">
          <div class="tab-strip primary-tabs" id="trend-metric-tabs">
            <button type="button" class="tab-button active" data-metric="pull_requests" aria-selected="true" title="{{ metric_description("pull_requests") }}">{{ metric_text("pull_requests") }}</button>
            <button type="button" class="tab-button" data-metric="pull_requests_per_active_author" aria-selected="false" title="{{ metric_description("pull_requests_per_active_author") }}">{{ metric_text("pull_requests_per_active_author") }}</button>
            <button type="button" class="tab-button" data-metric="changed_lines" aria-selected="false" title="{{ metric_description("changed_lines") }}">{{ metric_text("changed_lines") }}</button>
            <button type="button" class="tab-button" data-metric="changed_lines_per_active_author" aria-selected="false" title="{{ metric_description("changed_lines_per_active_author") }}">{{ metric_text("changed_lines_per_active_author") }}</button>
            <button type="button" class="tab-button" data-metric="median_approval_hours" aria-selected="false" title="{{ metric_description("median_approval_hours") }}">{{ metric_text("median_approval_hours") }}</button>
            <button type="button" class="tab-button" data-metric="median_first_review_hours" aria-selected="false" title="{{ metric_description("median_first_review_hours") }}">{{ metric_text("median_first_review_hours") }}</button>
            <button type="button" class="tab-button" data-metric="median_merge_hours" aria-selected="false" title="{{ metric_description("median_merge_hours") }}">{{ metric_text("median_merge_hours") }}</button>
          </div>
          <div class="tab-strip secondary-tabs" id="trend-grain-tabs">
            <button type="button" class="tab-button active" data-grain="weekly" aria-selected="true">{{ t("common.weekly") }}</button>
            <button type="button" class="tab-button" data-grain="monthly" aria-selected="false">{{ t("common.monthly") }}</button>
          </div>
        </div>
        <div class="chart-title">
          <span id="trend-chart-title">{{ metric_text("pull_requests") }}</span>
          <div class="chart-legend">
            <span class="legend-chip"><span class="legend-dot" style="background: var(--accent)"></span>{{ t("common.selected_metric") }}</span>
            <span class="legend-chip"><span class="legend-band" aria-hidden="true"></span>{{ t("common.open_period_legend") }}</span>
          </div>
        </div>
        <div id="trend-chart-readout" class="chart-readout"></div>
        <div id="trend-chart-root" class="chart-root"></div>
        <div class="support-grid">
          <article class="support-card">
            <strong>{{ t("dashboard.interpretation") }}</strong>
            <span>{{ t("dashboard.interpretation_copy") }}</span>
          </article>
          <article class="support-card">
            <strong>{{ t("dashboard.normalized_lens") }}</strong>
            <span>{{ t("dashboard.normalized_lens_copy") }} {{ overview.average_active_authors_per_month | numfmt }} {{ t("metric.average_active_authors_per_month") }}, {{ t("dashboard.normalized_lens_suffix") }} {{ overview.pull_requests_per_active_author | numfmt }} {{ t("metric.prs") }} / {{ overview.changed_lines_per_active_author | numfmt }} {% if locale == "en" %}Lines / active author{% else %}{{ metric_text("changed_lines_per_active_author") }}{% endif %}.</span>
          </article>
          <article class="support-card">
            <strong>{{ t("dashboard.backlog") }}</strong>
            <span>{{ overview.stale_open_pull_requests | intfmt }} {{ t("dashboard.backlog_copy") }}</span>
          </article>
        </div>
      </section>

      <section id="people" class="panel section-panel">
        <p class="section-kicker">{{ t("common.people") }}</p>
        <h2>{{ t("common.people") }}</h2>
        <p class="section-copy">{{ t("dashboard.people_copy") }}</p>
        <div class="people-grid">
          <div class="people-ranking-controls">
            <div class="tab-strip primary-tabs" id="people-metric-tabs" role="tablist" aria-label="{{ t("dashboard.people_ranking_metric") }}">
              <button type="button" class="tab-button active" data-people-metric="pull_requests" aria-selected="true" title="{{ metric_description("pull_requests") }}">{{ metric_text("pull_requests") }}</button>
              <button type="button" class="tab-button" data-people-metric="changed_lines" aria-selected="false" title="{{ metric_description("changed_lines") }}">{{ metric_text("changed_lines") }}</button>
              <button type="button" class="tab-button" data-people-metric="pull_requests_reviewed" aria-selected="false" title="{{ metric_description("pull_requests_reviewed") }}">{{ metric_text("pull_requests_reviewed") }}</button>
              <button type="button" class="tab-button" data-people-metric="reviewed_lines" aria-selected="false" title="{{ metric_description("reviewed_lines") }}">{{ metric_text("reviewed_lines") }}</button>
              <button type="button" class="tab-button" data-people-metric="median_approval_hours" aria-selected="false" title="{{ metric_description("median_approval_hours") }}">{{ metric_text("median_approval_hours") }}</button>
              <button type="button" class="tab-button" data-people-metric="median_first_review_hours" aria-selected="false" title="{{ metric_description("median_first_review_hours") }}">{{ metric_text("median_first_review_hours") }}</button>
              <button type="button" class="tab-button" data-people-metric="median_merge_hours" aria-selected="false" title="{{ metric_description("median_merge_hours") }}">{{ metric_text("median_merge_hours") }}</button>
            </div>
            <div class="detail-tabs secondary-tabs" id="author-detail-grain-tabs">
              <button type="button" class="tab-button active" data-author-grain="weekly" aria-selected="true">{{ t("common.weekly") }}</button>
              <button type="button" class="tab-button" data-author-grain="monthly" aria-selected="false">{{ t("common.monthly") }}</button>
            </div>
          </div>
          <div class="people-ranking-shell">
            <div class="control-row">
              <span class="control-note">{{ t("dashboard.people_top_note") }}</span>
            </div>
            <div id="people-ranking-list" class="person-list"></div>
            <div class="table-footer">
              <button type="button" id="people-ranking-toggle" class="ghost-button" aria-expanded="false"></button>
            </div>
          </div>
          <div id="author-detail" class="person-profile" tabindex="-1">
            <div class="profile-summary">
              <div>
                <p class="section-kicker">{{ t("dashboard.selected_profile") }}</p>
                <h2 id="author-detail-title">{{ t("dashboard.person_detail") }}</h2>
              </div>
              <span>{{ t("dashboard.author_reviewer_signals") }}</span>
            </div>
            <div class="chart-title">
              <span id="author-chart-title">{{ t("dashboard.author_chart") }}</span>
              <div class="chart-legend">
                <span class="legend-chip"><span class="legend-dot" style="background: var(--accent-2)"></span>{{ t("dashboard.selected_person") }}</span>
                <span class="legend-chip"><span class="legend-band" aria-hidden="true"></span>{{ t("common.open_period_legend") }}</span>
              </div>
            </div>
            <div id="author-chart-readout" class="chart-readout"></div>
            <div id="author-chart-root" class="chart-root"></div>
            <div id="author-detail-root" class="detail-shell"></div>
          </div>
        </div>
      </section>

      <section id="leaderboards" class="panel section-panel">
        <p class="section-kicker">{{ t("dashboard.repository_leaderboard") }}</p>
        <h2>{{ t("dashboard.repository_concentration") }}</h2>
        <p class="section-copy">{{ t("dashboard.repository_copy") }}</p>
        <div class="wide-stack">
        <article id="repositories">
          <p class="section-copy">{{ t("dashboard.top_repositories_cover") }} {{ reference_summary.repositories_top_coverage_pct | numfmt }}%{{ t("dashboard.top_repositories_suffix") }}</p>
          <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th class="rank">#</th>
                <th>{{ t("common.repository") }}</th>
                <th>{{ metric_text("repository_share") }}</th>
                <th class="num">{{ metric_text("pull_requests") }}</th>
                <th class="num">{{ metric_text("merged_pull_requests") }}</th>
                <th class="num tablet-hide">{{ metric_text("open_pull_requests") }}</th>
                <th class="num tablet-hide">{{ metric_text("authors") }}</th>
                <th class="num tablet-hide">{{ metric_text("average_reviews_per_pr") }}</th>
                <th class="num">{{ metric_text("median_approval_hours") }}</th>
                <th class="num tablet-hide">{{ metric_text("median_first_review_hours") }}</th>
              </tr>
            </thead>
            <tbody>
              {% for row in repositories_top %}
              <tr>
                <td class="rank" data-label="#"> {{ loop.index }}</td>
                <td class="leader" data-label="{{ t("common.repository") }}">
                  <strong>{{ row.repository_full_name }}</strong>
                  <span>{{ row.changed_lines | intfmt }} {{ t("metric.changed_lines") }}</span>
                </td>
                <td class="bar-cell" data-label="{{ metric_text("repository_share") }}">
                  <div class="bar-track">
                    <div class="bar-fill" style="width: {{ row.share_of_prs_pct or 0 }}%"></div>
                  </div>
                  <div class="bar-meta">
                    <span>{{ row.share_of_prs_pct }}%</span>
                    <span>{{ row.changed_lines | intfmt }} {{ t("metric.changed_lines") }}</span>
                  </div>
                </td>
                <td class="num" data-label="{{ metric_text("pull_requests") }}">{{ row.pull_requests | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("merged_pull_requests") }}">{{ row.merged_pull_requests | intfmt }}</td>
                <td class="num tablet-hide" data-label="{{ metric_text("open_pull_requests") }}">{{ row.open_pull_requests | intfmt }}</td>
                <td class="num tablet-hide" data-label="{{ metric_text("authors") }}">{{ row.authors | intfmt }}</td>
                <td class="num tablet-hide" data-label="{{ metric_text("average_reviews_per_pr") }}">{{ row.average_reviews_per_pr | numfmt }}</td>
                <td class="num" data-label="{% if locale == "en" %}Median approval{% else %}{{ metric_text("median_approval_hours") }}{% endif %}">{{ row.median_approval_hours | duration }}</td>
                <td class="num tablet-hide" data-label="{{ metric_text("median_first_review_hours") }}">{{ row.median_first_review_hours | duration }}</td>
              </tr>
              {% endfor %}
            </tbody>
            {% if repositories_rest %}
            <tbody id="repository-extra" class="hidden">
              {% for row in repositories_rest %}
              <tr>
                <td class="rank" data-label="#"> {{ loop.index + repositories_top|length }}</td>
                <td class="leader" data-label="{{ t("common.repository") }}">
                  <strong>{{ row.repository_full_name }}</strong>
                  <span>{{ row.changed_lines | intfmt }} {{ t("metric.changed_lines") }}</span>
                </td>
                <td class="bar-cell" data-label="{{ metric_text("repository_share") }}">
                  <div class="bar-track">
                    <div class="bar-fill" style="width: {{ row.share_of_prs_pct or 0 }}%"></div>
                  </div>
                  <div class="bar-meta">
                    <span>{{ row.share_of_prs_pct }}%</span>
                    <span>{{ row.changed_lines | intfmt }} {{ t("metric.changed_lines") }}</span>
                  </div>
                </td>
                <td class="num" data-label="{{ metric_text("pull_requests") }}">{{ row.pull_requests | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("merged_pull_requests") }}">{{ row.merged_pull_requests | intfmt }}</td>
                <td class="num tablet-hide" data-label="{{ metric_text("open_pull_requests") }}">{{ row.open_pull_requests | intfmt }}</td>
                <td class="num tablet-hide" data-label="{{ metric_text("authors") }}">{{ row.authors | intfmt }}</td>
                <td class="num tablet-hide" data-label="{{ metric_text("average_reviews_per_pr") }}">{{ row.average_reviews_per_pr | numfmt }}</td>
                <td class="num" data-label="{% if locale == "en" %}Median approval{% else %}{{ metric_text("median_approval_hours") }}{% endif %}">{{ row.median_approval_hours | duration }}</td>
                <td class="num tablet-hide" data-label="{{ metric_text("median_first_review_hours") }}">{{ row.median_first_review_hours | duration }}</td>
              </tr>
              {% endfor %}
            </tbody>
            {% endif %}
          </table>
          </div>
          {% if repositories_rest %}
          <div class="table-footer">
            <button type="button" id="repository-toggle" class="ghost-button" aria-expanded="false">
              {{ t("common.show_more_rows") }}
            </button>
          </div>
          {% endif %}
        </article>
        </div>
      </section>

      <section id="diagnostics" class="panel section-panel">
        <p class="section-kicker">{{ t("dashboard.latency_by_size") }}</p>
        <h2>{{ t("dashboard.size_flow") }}</h2>
        <p class="section-copy">{{ size_diagnostic.headline }} {{ size_diagnostic.supporting }}</p>
        <div class="summary-strip">
          <article class="summary-card panel">
            <span class="summary-label">{{ t("dashboard.latency_quality") }}</span>
            <strong>{{ overview.review_sla_24h_pct | numfmt }}% {{ t("metric.within_24h") }}</strong>
            <span>{{ t("dashboard.prs_first_review_day") }}</span>
          </article>
          <article class="summary-card panel">
            <span class="summary-label">{{ t("dashboard.review_depth") }}</span>
            <strong>{{ overview.average_reviews_per_pr | numfmt }} {{ t("metric.reviews_per_pr") }}</strong>
            <span>{{ overview.review_coverage_pct | numfmt }}%{{ t("dashboard.reviewed_prs") }}</span>
          </article>
          <article class="summary-card panel">
            <span class="summary-label">{{ metric_text("stale_open_pull_requests") }}</span>
            <strong>{{ overview.stale_open_pull_requests | intfmt }} {{ t("metric.stale_open_prs") }}</strong>
            <span>{{ t("dashboard.open_prs_older_72h") }}</span>
          </article>
          <article class="summary-card panel">
            <span class="summary-label">{{ metric_text("median_approval_hours") }}</span>
            <strong>{{ overview.median_approval_hours | duration }}</strong>
            <span>{{ overview.median_first_review_hours | duration }} {{ t("metric.median_first_review_window") }}</span>
          </article>
        </div>
        <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Size</th>
              <th class="num">{{ metric_text("pull_requests") }}</th>
              <th class="num">{{ metric_text("changed_lines") }}</th>
              <th class="num">{{ metric_text("median_first_review_hours") }}</th>
              <th class="num tablet-hide">{{ metric_text("median_approval_hours") }}</th>
              <th class="num">{{ metric_text("median_merge_hours") }}</th>
              <th class="num tablet-hide">{{ metric_text("average_reviews_per_pr") }}</th>
            </tr>
          </thead>
          <tbody>
            {% for row in size_buckets %}
            <tr>
              <td class="leader" data-label="Size">
                <strong>{{ row.bucket }}</strong>
                <span>{{ t("dashboard.latency_by_size") }}</span>
              </td>
              <td class="num" data-label="{{ metric_text("pull_requests") }}">{{ row.pull_requests | intfmt }}</td>
              <td class="num" data-label="{{ metric_text("changed_lines") }}">{{ row.median_changed_lines | numfmt }}</td>
              <td class="num" data-label="{{ metric_text("median_first_review_hours") }}">{{ row.median_first_review_hours | duration }}</td>
              <td class="num tablet-hide" data-label="{% if locale == "en" %}Median approval{% else %}{{ metric_text("median_approval_hours") }}{% endif %}">{{ row.median_approval_hours | duration }}</td>
              <td class="num" data-label="{{ metric_text("median_merge_hours") }}">{{ row.median_merge_hours | duration }}</td>
              <td class="num tablet-hide" data-label="{{ metric_text("average_reviews_per_pr") }}">{{ row.average_reviews_per_pr | numfmt }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        </div>
        <div class="tag-row">
          <span class="tag">XS: up to 100 changed lines</span>
          <span class="tag">S: 101-400</span>
          <span class="tag">M: 401-1000</span>
          <span class="tag">L: 1001-3000</span>
          <span class="tag">XL: 3001+</span>
        </div>
      </section>

      <section id="reference" class="panel section-panel reference-panel">
        <p class="section-kicker">{{ t("common.reference") }}</p>
        <h2>{{ t("dashboard.dense_tables") }}</h2>
        <p class="section-copy">{{ t("dashboard.reference_copy") }}</p>
        <div class="reference-grid">
          <details class="disclosure" open>
            <summary>{{ t("dashboard.trend_tables") }}</summary>
            <div class="tab-strip secondary-tabs" id="reference-trend-tabs" role="tablist" aria-label="{{ t("common.reference") }} {{ t("common.report_cadence") }}">
              <button type="button" class="tab-button active" id="reference-weekly-tab" role="tab" data-reference-trend="weekly" aria-controls="reference-weekly-panel" aria-selected="true">{{ t("common.weekly") }}</button>
              <button type="button" class="tab-button" id="reference-monthly-tab" role="tab" data-reference-trend="monthly" aria-controls="reference-monthly-panel" aria-selected="false">{{ t("common.monthly") }}</button>
            </div>
            <div class="reference-stack">
              <article id="reference-weekly-panel" role="tabpanel" aria-labelledby="reference-weekly-tab" data-reference-trend-panel="weekly">
                <div class="control-row">
                  <span class="control-note">{{ t("common.weekly") }} 5. {{ reference_summary.weekly_hidden_count | intfmt }} {{ t("common.rows_hidden_until_expanded") }}</span>
                </div>
                <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>{{ t("common.week") }}</th>
                      <th>{{ t("common.state") }}</th>
