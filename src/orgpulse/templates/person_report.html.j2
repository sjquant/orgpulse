<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>orgpulse person metrics: {{ result.login }}</title>
  {% include "org_dashboard/_theme_bootstrap.js.j2" %}
  {% include "org_dashboard/_styles.css.j2" %}
  <style>
    .person-report .hero-panel {
      margin-bottom: 16px;
    }

    .person-report .summary-strip {
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    }

    .person-report .section-panel {
      margin-bottom: 16px;
    }

    .person-report .stats-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .person-report .repository-focus-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 12px;
    }

    .person-report .repository-focus-card {
      display: grid;
      gap: 10px;
      border: 1px solid var(--line);
      border-radius: var(--radius-control);
      padding: 14px 16px;
      background: var(--panel-subtle);
    }

    .person-report .repository-focus-card strong {
      font-family: var(--font-display);
      overflow-wrap: anywhere;
    }

    .person-report .repository-focus-card span {
      color: var(--muted);
      font-size: 0.86rem;
      line-height: 1.45;
    }

    .person-report .table-heading {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: start;
      margin-bottom: 12px;
    }

    .person-report .table-heading > div {
      min-width: 0;
    }

    .person-report .table-heading .period-state-pill {
      flex-shrink: 0;
    }

    .person-report td:first-child {
      font-weight: 700;
      color: var(--text);
    }

    .person-report .metric-split {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .person-report .person-chart-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .person-report .person-chart-toolbar {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: start;
    }

    .person-report .chart-root {
      aspect-ratio: 16 / 6;
    }

    @media (max-width: 1180px) {
      .person-report .stats-grid,
      .person-report .repository-focus-grid,
      .person-report .metric-split,
      .person-report .person-chart-toolbar {
        grid-template-columns: 1fr;
      }

      .person-report .person-chart-toolbar {
        display: grid;
      }
    }

    @media (max-width: 720px) {
      .person-report .table-heading {
        display: grid;
      }
    }
  </style>
</head>
<body>
  <div class="shell person-report">
    <section class="hero">
      <div class="panel hero-panel">
        <div class="hero-head">
          <div class="hero-copy">
            <p class="eyebrow">Person Performance Extract</p>
            <h1>{{ result.login }} performance</h1>
            <p class="subtitle">
              Authored pull request metrics use {{ result.time_anchor.value }}.
              Review-given activity is counted by review submission time.
            </p>
          </div>
          <div class="theme-switch" role="group" aria-label="Color theme">
            <span class="theme-switch-indicator" aria-hidden="true"></span>
            <button type="button" class="theme-switch-button" data-theme-option="dark" aria-label="Dark theme" aria-pressed="false" title="Dark theme">
              <svg class="theme-switch-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 1 0 9.8 9.8Z"></path>
              </svg>
            </button>
            <button type="button" class="theme-switch-button" data-theme-option="light" aria-label="Light theme" aria-pressed="false" title="Light theme">
              <svg class="theme-switch-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4.1"></circle>
                <path d="M12 2.75v2.35"></path>
                <path d="M12 18.9v2.35"></path>
                <path d="M21.25 12h-2.35"></path>
                <path d="M5.1 12H2.75"></path>
                <path d="m18.55 5.45-1.66 1.66"></path>
                <path d="m7.11 16.89-1.66 1.66"></path>
                <path d="m18.55 18.55-1.66-1.66"></path>
                <path d="m7.11 7.11-1.66-1.66"></path>
              </svg>
            </button>
          </div>
        </div>
        <div class="hero-meta">
          <div class="meta-box">
            <span class="meta-label">Organization</span>
            <span class="meta-value">{{ result.target_org }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">Window</span>
            <span class="meta-value">{{ window_label }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">Grain</span>
            <span class="meta-value">{{ result.grain.value }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">Distribution cutoff</span>
            <span class="meta-value">{{ result.distribution_percentile }}th percentile</span>
          </div>
        </div>
      </div>
    </section>

    <section class="stats-grid" aria-label="Person summary metrics">
      <article class="stat-card">
        <span class="stat-label">Authored PRs</span>
        <div class="stat-value">{{ summary.authored_pull_request_count | intfmt }}</div>
        <div class="stat-subvalue">{{ summary.merged_pull_request_count | intfmt }} merged / {{ summary.open_pull_request_count | intfmt }} open</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">Merge rate</span>
        <div class="stat-value">{{ summary.merge_rate_pct | pctfmt }}</div>
        <div class="stat-subvalue">{{ summary.median_merge_hours | duration }} median merge time</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">Review coverage</span>
        <div class="stat-value">{{ summary.review_coverage_pct | pctfmt }}</div>
        <div class="stat-subvalue">{{ summary.reviews_received | intfmt }} review submissions received</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">Reviewer activity</span>
        <div class="stat-value">{{ reviewer_summary.review_submissions | intfmt }}</div>
        <div class="stat-subvalue">{{ reviewer_summary.pull_requests_reviewed | intfmt }} PRs reviewed</div>
      </article>
    </section>

    <section class="summary-strip" aria-label="Additional person metrics">
      <article class="summary-card panel">
        <span class="summary-label">Changed lines</span>
        <strong>{{ summary.changed_lines_total | intfmt }}</strong>
        <span>{{ summary.commits_total | intfmt }} commits across authored PRs</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">First review speed</span>
        <strong>{{ summary.median_first_review_hours | duration }}</strong>
        <span>median time to first review on authored PRs</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">Review decisions</span>
        <strong>{{ reviewer_summary.approvals | intfmt }} approvals</strong>
        <span>{{ reviewer_summary.changes_requested | intfmt }} changes requested / {{ reviewer_summary.comments | intfmt }} comments</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">Review reach</span>
        <strong>{{ reviewer_summary.repositories_reviewed | intfmt }} repositories</strong>
        <span>{{ reviewer_summary.authors_supported | intfmt }} authors supported</span>
      </article>
    </section>

    <nav class="section-nav" aria-label="Report sections">
      <a href="#charts">Charts</a>
      <a href="#periods">Periods</a>
      <a href="#repositories">Repositories</a>
      <a href="#methodology">Methodology</a>
    </nav>

    <div class="section-grid">
      <section id="charts" class="panel section-panel chart-panel">
        <div class="person-chart-toolbar">
          <div>
            <p class="section-kicker">Trend Charts</p>
            <h2>Weekly and monthly movement, graphed</h2>
            <p class="section-copy">Metric and grain tabs use the same local source data as the extract table.</p>
          </div>
          <div class="metric-split">
            <div class="tab-strip" id="person-trend-metric-tabs" role="tablist" aria-label="Trend metric">
              <button type="button" class="tab-button active" data-person-trend-metric="authored_pull_request_count" aria-selected="true">Authored PRs</button>
              <button type="button" class="tab-button" data-person-trend-metric="review_submissions_given" aria-selected="false">Reviews given</button>
              <button type="button" class="tab-button" data-person-trend-metric="changed_lines_total" aria-selected="false">Changed lines</button>
              <button type="button" class="tab-button" data-person-trend-metric="commits_total" aria-selected="false">Commits</button>
            </div>
            <div class="tab-strip" id="person-trend-grain-tabs" role="tablist" aria-label="Trend grain">
              <button type="button" class="tab-button active" data-person-trend-grain="weekly" aria-selected="true">Weekly</button>
              <button type="button" class="tab-button" data-person-trend-grain="monthly" aria-selected="false">Monthly</button>
            </div>
          </div>
        </div>
        <div class="person-chart-grid">
          <div class="chart-title">
            <span id="person-trend-chart-title">Person trend</span>
            <div class="chart-legend">
              <span class="legend-chip"><span class="legend-dot" style="background: var(--accent)"></span>Selected metric</span>
              <span class="legend-chip"><span class="legend-dot" style="background: var(--accent-2)"></span>Point readout</span>
            </div>
          </div>
          <div id="person-trend-chart-readout" class="chart-readout"></div>
          <div id="person-trend-chart-root" class="chart-root"></div>
        </div>
      </section>

      <section id="periods" class="panel section-panel">
        <div class="table-heading">
          <div>
            <p class="section-kicker">Period Tracking</p>
            <h2>{{ period_total_count | intfmt }} periods</h2>
            <p class="section-copy">Each row combines authored pull request flow with review-given activity for the same reporting period.</p>
          </div>
          <span class="period-state-pill{% if result.until is none %} open{% endif %}">
            {% if result.until is none %}source bounded{% else %}filtered window{% endif %}
          </span>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Period</th>
                <th class="num">Authored PRs</th>
                <th class="num">Merged</th>
                <th class="num">Open</th>
                <th class="num">Changed Lines</th>
                <th class="num">Commits</th>
                <th class="num">Reviews Received</th>
                <th class="num">Reviews Given</th>
                <th class="num">PRs Reviewed</th>
              </tr>
            </thead>
            <tbody>
              {% for row in period_recent_rows %}
              <tr>
                <td data-label="Period">{{ row.period_key }}</td>
                <td class="num" data-label="Authored PRs">{{ row.authored_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Merged">{{ row.merged_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Open">{{ row.open_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Changed Lines">{{ row.changed_lines_total | intfmt }}</td>
                <td class="num" data-label="Commits">{{ row.commits_total | intfmt }}</td>
                <td class="num" data-label="Reviews Received">{{ row.reviews_received | intfmt }}</td>
                <td class="num" data-label="Reviews Given">{{ row.review_submissions_given | intfmt }}</td>
                <td class="num" data-label="PRs Reviewed">{{ row.pull_requests_reviewed | intfmt }}</td>
              </tr>
              {% endfor %}
            </tbody>
            {% if period_older_rows %}
            <tbody id="period-extra" class="hidden">
              {% for row in period_older_rows %}
              <tr>
                <td data-label="Period">{{ row.period_key }}</td>
                <td class="num" data-label="Authored PRs">{{ row.authored_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Merged">{{ row.merged_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Open">{{ row.open_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Changed Lines">{{ row.changed_lines_total | intfmt }}</td>
                <td class="num" data-label="Commits">{{ row.commits_total | intfmt }}</td>
                <td class="num" data-label="Reviews Received">{{ row.reviews_received | intfmt }}</td>
                <td class="num" data-label="Reviews Given">{{ row.review_submissions_given | intfmt }}</td>
                <td class="num" data-label="PRs Reviewed">{{ row.pull_requests_reviewed | intfmt }}</td>
              </tr>
              {% endfor %}
            </tbody>
            {% endif %}
          </table>
        </div>
        {% if period_older_rows %}
        <div class="table-footer">
          <button type="button" id="period-toggle" class="ghost-button" aria-expanded="false">
            Show {{ [progressive_chunk_size, period_older_rows|length]|min }} more older {{ result.grain.value }} rows
          </button>
        </div>
        {% endif %}
      </section>

      <section id="repositories" class="panel section-panel">
        <div class="table-heading">
          <div>
            <p class="section-kicker">Repository Focus</p>
            <h2>{{ repository_total_count | intfmt }} repositories with person activity</h2>
            <p class="section-copy">Top repositories are ranked by authored PR count, then review activity and code volume.</p>
          </div>
        </div>
        <div class="repository-focus-grid">
          {% for row in top_repository_rows %}
          <article class="repository-focus-card">
            <strong>{{ row.repository_full_name }}</strong>
            <span>{{ row.authored_pull_request_count | intfmt }} authored PRs / {{ row.review_submissions_given | intfmt }} reviews given</span>
            <span>{{ row.changed_lines_total | intfmt }} changed lines</span>
          </article>
          {% endfor %}
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Repository</th>
                <th class="num">Authored PRs</th>
                <th class="num">Merged</th>
                <th class="num">Open</th>
                <th class="num">Changed Lines</th>
                <th class="num">Reviews Given</th>
                <th class="num">PRs Reviewed</th>
              </tr>
            </thead>
            <tbody>
              {% for row in repository_top_rows %}
              <tr>
                <td data-label="Repository">{{ row.repository_full_name }}</td>
                <td class="num" data-label="Authored PRs">{{ row.authored_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Merged">{{ row.merged_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Open">{{ row.open_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Changed Lines">{{ row.changed_lines_total | intfmt }}</td>
                <td class="num" data-label="Reviews Given">{{ row.review_submissions_given | intfmt }}</td>
                <td class="num" data-label="PRs Reviewed">{{ row.pull_requests_reviewed | intfmt }}</td>
              </tr>
              {% endfor %}
            </tbody>
            {% if repository_rest_rows %}
            <tbody id="repository-extra" class="hidden">
              {% for row in repository_rest_rows %}
              <tr>
                <td data-label="Repository">{{ row.repository_full_name }}</td>
                <td class="num" data-label="Authored PRs">{{ row.authored_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Merged">{{ row.merged_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Open">{{ row.open_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Changed Lines">{{ row.changed_lines_total | intfmt }}</td>
                <td class="num" data-label="Reviews Given">{{ row.review_submissions_given | intfmt }}</td>
                <td class="num" data-label="PRs Reviewed">{{ row.pull_requests_reviewed | intfmt }}</td>
              </tr>
              {% endfor %}
            </tbody>
            {% endif %}
          </table>
        </div>
        {% if repository_rest_rows %}
        <div class="table-footer">
          <button type="button" id="repository-toggle" class="ghost-button" aria-expanded="false">
            Show {{ [progressive_chunk_size, repository_rest_rows|length]|min }} more repositories
          </button>
        </div>
        {% endif %}
      </section>

      <section id="methodology" class="panel section-panel reference-panel">
        <p class="section-kicker">Methodology</p>
        <h2>How this extract is counted</h2>
        <div class="methodology-grid">
          <article class="support-card">
            <strong>Authored work</strong>
            <span>Authored PRs are filtered by {{ result.time_anchor.value }} and grouped by {{ result.grain.value }}.</span>
          </article>
          <article class="support-card">
            <strong>Review work</strong>
            <span>Reviews given are filtered and grouped by review submission time, even if the PR was created earlier.</span>
          </article>
          <article class="support-card">
            <strong>Source</strong>
            <span>Uses normalized orgpulse snapshots already present for the selected organization, grain, and anchor.</span>
          </article>
        </div>
      </section>
    </div>
  </div>

  <script id="person-report-data" type="application/json">{{ report_payload | json_script }}</script>
  <script>
    (function () {
      const storageKey = "orgpulse-manual-dashboard-theme";
      const root = document.documentElement;
      const switcher = document.querySelector(".theme-switch");
      const buttons = Array.from(document.querySelectorAll(".theme-switch-button"));
      const periodToggle = document.getElementById("period-toggle");
      const periodExtra = document.getElementById("period-extra");
      const repositoryToggle = document.getElementById("repository-toggle");
      const repositoryExtra = document.getElementById("repository-extra");
      const report = JSON.parse(document.getElementById("person-report-data").textContent);
      const trendSeries = {
        weekly: Array.isArray(report.weekly_period_rows) ? report.weekly_period_rows : [],
        monthly: Array.isArray(report.monthly_period_rows) ? report.monthly_period_rows : [],
      };
      const trendMetricTabs = Array.from(document.querySelectorAll("#person-trend-metric-tabs .tab-button"));
      const trendGrainTabs = Array.from(document.querySelectorAll("#person-trend-grain-tabs .tab-button"));
      const trendChartTitle = document.getElementById("person-trend-chart-title");
      const trendChartReadout = document.getElementById("person-trend-chart-readout");
      const trendChartRoot = document.getElementById("person-trend-chart-root");
      const sectionNavLinks = Array.from(document.querySelectorAll('.section-nav a[href^="#"]'));
      const sectionTargets = sectionNavLinks
        .map(link => {
          const sectionId = link.getAttribute("href")?.slice(1);
          if (!sectionId) {
            return null;
          }
          const section = document.getElementById(sectionId);
          if (!section) {
            return null;
          }
          return { link, section, sectionId };
        })
        .filter(Boolean);
      let activeTrendMetric = "authored_pull_request_count";
      let activeTrendGrain = report.grain === "week" ? "weekly" : "monthly";
      let activeTrendPointIndex = null;

      function activeTheme() {
        return root.dataset.theme || "dark";
      }

      function syncThemeButtons() {
        const theme = activeTheme();
        if (switcher) {
          switcher.dataset.activeTheme = theme;
        }
        buttons.forEach(button => {
          button.setAttribute(
            "aria-pressed",
            button.dataset.themeOption === theme ? "true" : "false",
          );
        });
      }

      buttons.forEach(button => {
        button.addEventListener("click", () => {
          const theme = button.dataset.themeOption;
          root.dataset.theme = theme;
          try {
            window.localStorage.setItem(storageKey, theme);
          } catch (_error) {
            // Ignore localStorage failures; the current page state still updates.
          }
          syncThemeButtons();
          renderPersonTrendChart();
        });
      });

      syncThemeButtons();
      syncTrendMetricTabs();
      syncTrendGrainTabs();
      syncActiveSectionNav();
      setupSectionSpy();
      renderPersonTrendChart();
      trendMetricTabs.forEach(button => {
        button.addEventListener("click", () => {
          activeTrendMetric = button.dataset.personTrendMetric;
          activeTrendPointIndex = null;
          syncTrendMetricTabs();
          renderPersonTrendChart();
        });
      });
      trendGrainTabs.forEach(button => {
        button.addEventListener("click", () => {
          activeTrendGrain = button.dataset.personTrendGrain;
          activeTrendPointIndex = null;
          syncTrendGrainTabs();
          renderPersonTrendChart();
        });
      });
      window.addEventListener("resize", renderPersonTrendChart);
      setupProgressiveToggle({
        button: periodToggle,
        container: periodExtra,
        items: periodExtra ? Array.from(periodExtra.querySelectorAll("tr")) : [],
        chunkSize: {{ progressive_chunk_size }},
        label: "older {{ result.grain.value }} rows",
      });
      setupProgressiveToggle({
        button: repositoryToggle,
        container: repositoryExtra,
        items: repositoryExtra ? Array.from(repositoryExtra.querySelectorAll("tr")) : [],
        chunkSize: {{ progressive_chunk_size }},
        label: "repositories",
      });

      function setupProgressiveToggle({ button, container, items, chunkSize, label }) {
        if (!button || !container || !items.length) {
          return;
        }
        let visibleCount = 0;
        sync();
        button.addEventListener("click", () => {
          if (visibleCount >= items.length) {
            visibleCount = 0;
          } else {
            visibleCount = Math.min(items.length, visibleCount + chunkSize);
          }
          sync();
        });

        function sync() {
          container.classList.toggle("hidden", visibleCount === 0);
          items.forEach((item, index) => {
            item.classList.toggle("hidden", index >= visibleCount);
          });
          const remaining = Math.max(0, items.length - visibleCount);
          if (remaining === 0) {
            button.textContent = `Collapse ${label}`;
            button.setAttribute("aria-expanded", "true");
            return;
          }
          button.textContent = `Show ${Math.min(chunkSize, remaining)} more ${label}`;
          button.setAttribute("aria-expanded", String(visibleCount > 0));
        }
      }

      function syncActiveSectionNav(activeSectionId = null) {
        const fallbackSectionId = activeSectionId || currentSectionId();
        sectionTargets.forEach(target => {
          target.link.setAttribute(
            "aria-current",
            String(target.sectionId === fallbackSectionId),
          );
        });
      }

      function currentSectionId() {
        let selected = sectionTargets[0]?.sectionId ?? null;
        let bestDistance = Number.POSITIVE_INFINITY;
        sectionTargets.forEach(target => {
          const rect = target.section.getBoundingClientRect();
          const distance = Math.abs(rect.top - 116);
          if (rect.top <= window.innerHeight * 0.55 && distance < bestDistance) {
            selected = target.sectionId;
            bestDistance = distance;
          }
        });
        return selected;
      }

      function setupSectionSpy() {
        if (!("IntersectionObserver" in window) || !sectionTargets.length) {
          window.addEventListener("scroll", () => syncActiveSectionNav(), { passive: true });
          return;
        }
        const visibleSections = new Map();
        const observer = new IntersectionObserver(
          entries => {
            entries.forEach(entry => {
              const sectionId = entry.target.getAttribute("id");
              if (!sectionId) {
                return;
              }
              if (entry.isIntersecting) {
                visibleSections.set(sectionId, entry.intersectionRatio);
              } else {
                visibleSections.delete(sectionId);
              }
            });
            if (!visibleSections.size) {
              syncActiveSectionNav();
              return;
            }
            const [activeSectionId] = [...visibleSections.entries()].sort((left, right) => {
              if (right[1] !== left[1]) {
                return right[1] - left[1];
              }
              return (
                sectionTargets.findIndex(target => target.sectionId === left[0])
                - sectionTargets.findIndex(target => target.sectionId === right[0])
              );
            })[0];
            syncActiveSectionNav(activeSectionId);
          },
          {
            root: null,
            rootMargin: "-18% 0px -58% 0px",
            threshold: [0.15, 0.3, 0.45, 0.6],
          },
        );
        sectionTargets.forEach(target => observer.observe(target.section));
        window.addEventListener("scroll", () => syncActiveSectionNav(), { passive: true });
      }

      function syncTrendMetricTabs() {
        trendMetricTabs.forEach(button => {
          const isActive = button.dataset.personTrendMetric === activeTrendMetric;
          button.classList.toggle("active", isActive);
          button.setAttribute("aria-selected", String(isActive));
        });
      }

      function syncTrendGrainTabs() {
        trendGrainTabs.forEach(button => {
          const isActive = button.dataset.personTrendGrain === activeTrendGrain;
          button.classList.toggle("active", isActive);
          button.setAttribute("aria-selected", String(isActive));
        });
      }

      function renderPersonTrendChart() {
        if (!trendChartRoot || !trendChartReadout || !trendChartTitle) {
          return;
        }
        const trendRows = trendSeries[activeTrendGrain] || [];
        const grainLabel = activeTrendGrain === "weekly" ? "week" : "month";
        activeTrendPointIndex = clampSelectedIndex(trendRows, activeTrendPointIndex, activeTrendMetric);
        trendChartTitle.textContent = `${metricLabel(activeTrendMetric)} by ${grainLabel}`;
        trendChartReadout.innerHTML = renderTrendReadout(trendRows, activeTrendMetric, activeTrendPointIndex);
        renderSeriesChart({
          element: trendChartRoot,
          rows: trendRows,
          metric: activeTrendMetric,
          selectedIndex: activeTrendPointIndex,
          onSelect: index => {
            activeTrendPointIndex = index;
            renderPersonTrendChart();
          },
        });
      }

      function renderTrendReadout(rows, metric, selectedIndex) {
        if (!rows.length) {
          return readoutCard("Selected period", "-")
            + readoutCard(metricLabel(metric), "-")
            + readoutCard("Authored PRs", "-")
            + readoutCard("Reviews given", "-");
        }
        const selectedRow = rows[selectedIndex] || rows[rows.length - 1];
        return [
          readoutCard("Selected period", selectedRow.period_key || "-"),
          readoutCard(metricLabel(metric), formatMetricValue(selectedRow[metric], metric)),
          readoutCard("Authored PRs", formatMetricValue(selectedRow.authored_pull_request_count, "authored_pull_request_count")),
          readoutCard("Reviews given", formatMetricValue(selectedRow.review_submissions_given, "review_submissions_given")),
        ].join("");
      }

      function readoutCard(label, value) {
        return `<article class="readout-card"><strong>${escapeHtml(label)}</strong><span>${escapeHtml(value)}</span></article>`;
      }

      function renderSeriesChart({ element, rows, metric, selectedIndex, onSelect }) {
        if (!rows.length) {
          element.innerHTML = `<div class="small-note">No period data available.</div>`;
          return;
        }
        const width = 920;
        const height = 320;
        const padding = { top: 20, right: 18, bottom: 42, left: 56 };
        const plotWidth = width - padding.left - padding.right;
        const plotHeight = height - padding.top - padding.bottom;
        const points = rows
          .map((row, index) => ({ row, index, value: toNumber(row[metric]) }))
          .filter(point => point.value !== null);
        if (!points.length) {
          element.innerHTML = `<div class="small-note">No data for this metric.</div>`;
          return;
        }
        const maxValue = Math.max(1, ...points.map(point => point.value));
        const stepX = rows.length > 1 ? plotWidth / (rows.length - 1) : plotWidth / 2;
        const xFor = index => rows.length > 1 ? padding.left + index * stepX : padding.left + plotWidth / 2;
        const yFor = value => padding.top + plotHeight - (value / maxValue) * plotHeight;
        const linePath = points
          .map((point, pathIndex) => `${pathIndex === 0 ? "M" : "L"} ${xFor(point.index)} ${yFor(point.value)}`)
          .join(" ");
        const areaPath = points.length
          ? `${linePath} L ${xFor(points.at(-1).index)} ${padding.top + plotHeight} L ${xFor(points[0].index)} ${padding.top + plotHeight} Z`
          : "";
        const averageValue = points.reduce((sum, point) => sum + point.value, 0) / points.length;
        const averageLineY = yFor(averageValue);
        const labelInterval = chartLabelInterval(rows.length);
        const ticks = [0, 0.25, 0.5, 0.75, 1].map(ratio => {
          const value = maxValue * ratio;
          const y = padding.top + plotHeight - plotHeight * ratio;
          return `
            <line x1="${padding.left}" x2="${width - padding.right}" y1="${y}" y2="${y}" stroke="${cssVar("--grid-stroke")}"></line>
            <text x="${padding.left - 10}" y="${y + 4}" text-anchor="end" class="chart-axis">${formatMetricValue(value, metric)}</text>
          `;
        }).join("");
        const chartNodes = rows.map((row, index) => {
          const value = toNumber(row[metric]);
          if (value === null) {
            return "";
          }
          const isSelected = index === selectedIndex;
          const showLabel = index === 0 || index === rows.length - 1 || index % labelInterval === 0;
          return `
            <g class="chart-node" data-point-index="${index}" data-point-label="${escapeAttribute(row.period_key || "-")}" data-point-value="${escapeAttribute(formatMetricValue(value, metric))}" tabindex="0" role="button" aria-label="${escapeAttribute(`${row.period_key || "Period"} ${formatMetricValue(value, metric)}`)}">
              <circle cx="${xFor(index)}" cy="${yFor(value)}" r="${isSelected ? 6 : 4}" fill="${cssVar("--accent")}" stroke="${isSelected ? cssVar("--text") : "transparent"}" stroke-width="${isSelected ? 2 : 0}">
                <title>${escapeHtml(row.period_key || "-")}: ${escapeHtml(formatMetricValue(value, metric))}</title>
              </circle>
            </g>
            ${showLabel ? `<text x="${xFor(index)}" y="${height - 12}" text-anchor="middle" class="chart-axis">${escapeHtml(shortLabel(row.period_key || ""))}</text>` : ""}
          `;
        }).join("");
        element.innerHTML = `
          <svg viewBox="0 0 ${width} ${height}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="${escapeAttribute(metricLabel(metric))} chart">
            <defs>
              <linearGradient id="person-series-fill-${metric}" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%" stop-color="${cssVar("--accent")}" stop-opacity="0.22"></stop>
                <stop offset="100%" stop-color="${cssVar("--accent")}" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            ${ticks}
            <line x1="${padding.left}" x2="${width - padding.right}" y1="${averageLineY}" y2="${averageLineY}" stroke="${cssVar("--avg-stroke")}" stroke-dasharray="5 5"></line>
            ${areaPath ? `<path d="${areaPath}" fill="url(#person-series-fill-${metric})"></path>` : ""}
            <path d="${linePath}" fill="none" stroke="${cssVar("--accent")}" stroke-width="3" stroke-linecap="round"></path>
            ${chartNodes}
          </svg>
        `;
        bindChartSelection(element, metric, onSelect);
      }

      function bindChartSelection(element, metric, onSelect) {
        const tooltip = ensureChartTooltip(element);
        element.querySelectorAll("[data-point-index]").forEach(node => {
          const select = event => {
            onSelect(Number(node.dataset.pointIndex));
            showChartTooltip(tooltip, element, node, metric, event);
          };
          const show = event => showChartTooltip(tooltip, element, node, metric, event);
          node.addEventListener("click", select);
          node.addEventListener("focus", select);
          node.addEventListener("mouseenter", show);
          node.addEventListener("mousemove", show);
          node.addEventListener("mouseleave", () => hideChartTooltip(tooltip));
          node.addEventListener("blur", () => hideChartTooltip(tooltip));
        });
        element.addEventListener("mouseleave", () => hideChartTooltip(tooltip));
      }

      function ensureChartTooltip(element) {
        let tooltip = element.querySelector(".chart-tooltip");
        if (tooltip) {
          return tooltip;
        }
        tooltip = document.createElement("div");
        tooltip.className = "chart-tooltip hidden";
        tooltip.setAttribute("aria-hidden", "true");
        element.appendChild(tooltip);
        return tooltip;
      }

      function showChartTooltip(tooltip, chartElement, node, metric, event) {
        tooltip.innerHTML = `
          <strong>${escapeHtml(node.dataset.pointLabel || "-")}</strong>
          <span>${escapeHtml(metricLabel(metric))}: ${escapeHtml(node.dataset.pointValue || "-")}</span>
        `;
        tooltip.classList.remove("hidden");
        tooltip.setAttribute("aria-hidden", "false");
        const chartRect = chartElement.getBoundingClientRect();
        const nodeRect = node.getBoundingClientRect();
        const left = Math.min(
          chartRect.width - tooltip.offsetWidth - 10,
          Math.max(10, (event?.clientX ?? nodeRect.left + nodeRect.width / 2) - chartRect.left + 12),
        );
        const top = Math.min(
          chartRect.height - tooltip.offsetHeight - 10,
          Math.max(10, nodeRect.top - chartRect.top - tooltip.offsetHeight - 8),
        );
        tooltip.style.transform = `translate(${left}px, ${top}px)`;
      }

      function hideChartTooltip(tooltip) {
        tooltip.classList.add("hidden");
        tooltip.setAttribute("aria-hidden", "true");
      }

      function clampSelectedIndex(rows, selectedIndex, metric) {
        if (!rows.length) {
          return null;
        }
        if (selectedIndex !== null && rows[selectedIndex] && toNumber(rows[selectedIndex][metric]) !== null) {
          return selectedIndex;
        }
        for (let index = rows.length - 1; index >= 0; index -= 1) {
          if (toNumber(rows[index][metric]) !== null) {
            return index;
          }
        }
        return rows.length - 1;
      }

      function metricLabel(metric) {
        return {
          authored_pull_request_count: "Authored PRs",
          review_submissions_given: "Reviews given",
          changed_lines_total: "Changed lines",
          commits_total: "Commits",
        }[metric] || metric;
      }

      function formatMetricValue(value, metric) {
        const number = toNumber(value);
        if (number === null) {
          return "-";
        }
        return new Intl.NumberFormat("en-US", {
          maximumFractionDigits: Number.isInteger(number) ? 0 : 2,
        }).format(number);
      }

      function toNumber(value) {
        if (value === null || value === undefined || value === "") {
          return null;
        }
        const number = Number(value);
        return Number.isFinite(number) ? number : null;
      }

      function chartLabelInterval(length) {
        if (length <= 8) {
          return 1;
        }
        if (length <= 16) {
          return 2;
        }
        return Math.ceil(length / 8);
      }

      function shortLabel(value) {
        const text = String(value);
        if (text.includes("-W")) {
          return text.replace(/^(\d{4})-W/, "W");
        }
        return text.replace(/^\d{4}-/, "");
      }

      function cssVar(name) {
        return getComputedStyle(root).getPropertyValue(name).trim();
      }

      function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, character => ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        }[character]));
      }

      function escapeAttribute(value) {
        return escapeHtml(value);
      }
    }());
  </script>
</body>
</html>
