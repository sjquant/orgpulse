<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ t("person.title_prefix") }}: {{ result.login }}</title>
  {% include "common/_theme_bootstrap.js.j2" %}
  {% include "common/_styles.css.j2" %}
  {% include "person_report/_styles.css.j2" %}
</head>
<body>
  <div class="shell person-report">
    <section class="hero">
      <div class="panel hero-panel">
        <div class="hero-head">
          <div class="hero-copy">
            <p class="eyebrow">{{ t("person.eyebrow") }}</p>
            <h1>{{ result.login }} {{ t("person.heading_suffix") }}</h1>
            <p class="subtitle">
              {{ t("person.authored_anchor_prefix") }} {{ result.time_anchor.value }}.
              {{ t("person.subtitle_suffix") }}
            </p>
          </div>
          <div class="theme-switch" role="group" aria-label="{{ t("theme.color") }}">
            <span class="theme-switch-indicator" aria-hidden="true"></span>
            <button type="button" class="theme-switch-button" data-theme-option="dark" aria-label="{{ t("theme.dark") }}" aria-pressed="false" title="{{ t("theme.dark") }}">
              <svg class="theme-switch-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 1 0 9.8 9.8Z"></path>
              </svg>
            </button>
            <button type="button" class="theme-switch-button" data-theme-option="light" aria-label="{{ t("theme.light") }}" aria-pressed="false" title="{{ t("theme.light") }}">
              <svg class="theme-switch-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4.1"></circle>
                <path d="M12 2.75v2.35"></path>
                <path d="M12 18.9v2.35"></path>
                <path d="M21.25 12h-2.35"></path>
                <path d="M5.1 12H2.75"></path>
                <path d="m18.55 5.45-1.66 1.66"></path>
                <path d="m7.11 16.89-1.66 1.66"></path>
                <path d="m18.55 18.55-1.66-1.66"></path>
                <path d="m7.11 7.11-1.66-1.66"></path>
              </svg>
            </button>
          </div>
        </div>
        <div class="hero-meta">
          <div class="meta-box">
            <span class="meta-label">{{ t("common.organization") }}</span>
            <span class="meta-value">{{ result.target_org }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">{{ t("common.window") }}</span>
            <span class="meta-value">{{ window_label }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">{{ t("common.source_grain") }}</span>
            <span class="meta-value">{{ result.grain.value }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">{{ t("common.distribution_cutoff") }}</span>
            <span class="meta-value">{{ result.distribution_percentile }}{{ t("common.percentile") }}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="stats-grid" aria-label="{{ t("person.title_prefix") }}">
      <article class="stat-card">
        <span class="stat-label">{{ metric_label("authored_pull_request_count") }}</span>
        <div class="stat-value">{{ summary.authored_pull_request_count | intfmt }}</div>
        <div class="stat-subvalue">{{ summary.merged_pull_request_count | intfmt }} {{ t("metric.merged") }} / {{ summary.open_pull_request_count | intfmt }} {{ t("metric.open") }}</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">{{ metric_label("merge_rate_pct") }}</span>
        <div class="stat-value">{{ summary.merge_rate_pct | pctfmt }}</div>
        <div class="stat-subvalue">{{ summary.median_merge_hours | duration }} {{ t("metric.median_merge_time") }}</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">{{ metric_label("review_coverage_pct") }}</span>
        <div class="stat-value">{{ summary.review_coverage_pct | pctfmt }}</div>
        <div class="stat-subvalue">{{ summary.reviews_received | intfmt }} {{ t("metric.review_submissions_received") }}</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">{{ metric_label("pull_requests_reviewed") }}</span>
        <div class="stat-value">{{ reviewer_summary.pull_requests_reviewed | intfmt }}</div>
        <div class="stat-subvalue">{{ reviewer_summary.review_submissions | intfmt }} {{ t("metric.review_submissions") }} / {{ reviewer_summary.pull_requests_reviewed_per_month | numfmt }} {{ t("metric.prs_per_month") }}</div>
      </article>
    </section>

    <section class="summary-strip" aria-label="{{ t("person.title_prefix") }}">
      <article class="summary-card panel">
        <span class="summary-label">{{ metric_label("changed_lines_total") }}</span>
        <strong>{{ summary.changed_lines_total | intfmt }}</strong>
        <span>{{ summary.commits_total | intfmt }} {{ t("metric.commits_across_authored_prs") }}</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">{{ metric_label("median_approval_hours") }}</span>
        <strong>{{ summary.median_approval_hours | duration }}</strong>
        <span>{{ t("metric.median_approval_time") }}</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">{{ metric_label("review_submissions_given") }}</span>
        <strong>{{ reviewer_summary.approvals | intfmt }} {{ t("metric.approvals") }}</strong>
        <span>{{ reviewer_summary.changes_requested | intfmt }} {{ t("metric.changes_requested") }} / {{ reviewer_summary.comments | intfmt }} {{ t("metric.comments") }}</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">{{ metric_label("reviewed_lines") }}</span>
        <strong>{{ reviewer_summary.reviewed_lines | intfmt }}</strong>
        <span>{{ reviewer_summary.reviewed_lines_per_month | numfmt }} {{ t("metric.lines_per_month") }}</span>
      </article>
    </section>

    <nav class="section-nav" aria-label="{{ t("common.report_sections") }}">
      <a href="#charts">{{ t("common.charts") }}</a>
      <a href="#cadences">{{ t("common.weekly") }} / {{ t("common.monthly") }}</a>
      <a href="#repositories">{{ t("common.repositories") }}</a>
      <a href="#methodology">{{ t("common.methodology") }}</a>
    </nav>

    <div class="section-grid">
      <section id="charts" class="panel section-panel chart-panel">
        <div class="person-chart-toolbar">
          <div>
            <p class="section-kicker">{{ t("common.trends") }}</p>
            <h2>{{ t("common.weekly") }} / {{ t("common.monthly") }}</h2>
            <p class="section-copy">{{ t("person.chart_copy") }}</p>
          </div>
        </div>
        {% if result.include_org_trends %}
        <article class="chart-card org-chart-card">
          <div>
            <p class="section-kicker">{{ t("common.organization") }}</p>
            <h3>{{ t("common.organization") }} {{ t("common.trends") }}</h3>
          </div>
          <div class="two-col">
            <div class="tab-strip primary-tabs" id="org-trend-metric-tabs" role="tablist" aria-label="{{ t("common.organization") }} {{ t("analysis.metric") }}">
              <button type="button" class="tab-button active" data-org-trend-metric="pull_requests" aria-selected="true" title="{{ metric_description("pull_requests") }}">{{ metric_text("pull_requests") }}</button>
              <button type="button" class="tab-button" data-org-trend-metric="pull_requests_per_active_author" aria-selected="false" title="{{ metric_description("pull_requests_per_active_author") }}">{{ metric_text("pull_requests_per_active_author") }}</button>
              <button type="button" class="tab-button" data-org-trend-metric="changed_lines" aria-selected="false" title="{{ metric_description("changed_lines") }}">{{ metric_text("changed_lines") }}</button>
              <button type="button" class="tab-button" data-org-trend-metric="changed_lines_per_active_author" aria-selected="false" title="{{ metric_description("changed_lines_per_active_author") }}">{{ metric_text("changed_lines_per_active_author") }}</button>
              <button type="button" class="tab-button" data-org-trend-metric="median_approval_hours" aria-selected="false" title="{{ metric_description("median_approval_hours") }}">{{ metric_text("median_approval_hours") }}</button>
              <button type="button" class="tab-button" data-org-trend-metric="median_first_review_hours" aria-selected="false" title="{{ metric_description("median_first_review_hours") }}">{{ metric_text("median_first_review_hours") }}</button>
              <button type="button" class="tab-button" data-org-trend-metric="median_merge_hours" aria-selected="false" title="{{ metric_description("median_merge_hours") }}">{{ metric_text("median_merge_hours") }}</button>
            </div>
            <div class="tab-strip secondary-tabs" id="org-trend-grain-tabs" role="tablist" aria-label="{{ t("common.organization") }} {{ t("common.source_grain") }}">
              <button type="button" class="tab-button active" data-org-trend-grain="weekly" aria-selected="true">{{ t("common.weekly") }}</button>
              <button type="button" class="tab-button" data-org-trend-grain="monthly" aria-selected="false">{{ t("common.monthly") }}</button>
            </div>
          </div>
          <div class="chart-title">
            <span id="org-trend-chart-title">{{ t("common.organization") }} {{ t("common.trends") }}</span>
            <div class="chart-legend">
              <span class="legend-chip"><span class="legend-dot" style="background: var(--accent)"></span>{{ t("common.selected_metric") }}</span>
              <span class="legend-chip"><span class="legend-band" aria-hidden="true"></span>{{ t("common.open_period_legend") }}</span>
            </div>
          </div>
          <div id="org-trend-chart-readout" class="chart-readout"></div>
          <div id="org-trend-chart-root" class="chart-root"></div>
        </article>
        {% endif %}
        <article class="chart-card person-trend-card">
          <div>
            <p class="section-kicker">{{ t("person.eyebrow") }}</p>
            <h3>{{ result.login }} {{ t("common.trends") }}</h3>
          </div>
          <div class="two-col">
            <div class="tab-strip primary-tabs" id="person-trend-metric-tabs" role="tablist" aria-label="{{ t("analysis.metric") }}">
              <button type="button" class="tab-button active" data-person-trend-metric="authored_pull_request_count" aria-selected="true" title="{{ metric_description("authored_pull_request_count") }}">{{ metric_text("authored_pull_request_count") }}</button>
              <button type="button" class="tab-button" data-person-trend-metric="review_submissions_given" aria-selected="false" title="{{ metric_description("review_submissions_given") }}">{{ metric_text("review_submissions_given") }}</button>
              <button type="button" class="tab-button" data-person-trend-metric="pull_requests_reviewed" aria-selected="false" title="{{ metric_description("pull_requests_reviewed") }}">{{ metric_text("pull_requests_reviewed") }}</button>
              <button type="button" class="tab-button" data-person-trend-metric="reviewed_lines" aria-selected="false" title="{{ metric_description("reviewed_lines") }}">{{ metric_text("reviewed_lines") }}</button>
              <button type="button" class="tab-button" data-person-trend-metric="median_merge_hours" aria-selected="false" title="{{ metric_description("median_merge_hours") }}">{{ metric_text("median_merge_hours") }}</button>
              <button type="button" class="tab-button" data-person-trend-metric="median_first_review_hours" aria-selected="false" title="{{ metric_description("median_first_review_hours") }}">{{ metric_text("median_first_review_hours") }}</button>
              <button type="button" class="tab-button" data-person-trend-metric="median_approval_hours" aria-selected="false" title="{{ metric_description("median_approval_hours") }}">{{ metric_text("median_approval_hours") }}</button>
              <button type="button" class="tab-button" data-person-trend-metric="changed_lines_total" aria-selected="false" title="{{ metric_description("changed_lines_total") }}">{{ metric_text("changed_lines_total") }}</button>
              <button type="button" class="tab-button" data-person-trend-metric="commits_total" aria-selected="false" title="{{ metric_description("commits_total") }}">{{ metric_text("commits_total") }}</button>
            </div>
            <div class="tab-strip secondary-tabs" id="person-trend-grain-tabs" role="tablist" aria-label="{{ t("common.source_grain") }}">
              <button type="button" class="tab-button active" data-person-trend-grain="weekly" aria-selected="true">{{ t("common.weekly") }}</button>
              <button type="button" class="tab-button" data-person-trend-grain="monthly" aria-selected="false">{{ t("common.monthly") }}</button>
            </div>
          </div>
          <div class="chart-title">
            <span id="person-trend-chart-title">{{ t("person.eyebrow") }} {{ t("common.trends") }}</span>
            <div class="chart-legend">
              <span class="legend-chip"><span class="legend-dot" style="background: var(--accent)"></span>{{ t("common.selected_metric") }}</span>
              <span class="legend-chip"><span class="legend-band" aria-hidden="true"></span>{{ t("common.open_period_legend") }}</span>
            </div>
          </div>
          <div id="person-trend-chart-readout" class="chart-readout"></div>
          <div id="person-trend-chart-root" class="chart-root"></div>
        </article>
      </section>

      <section id="cadences" class="panel section-panel">
        <div class="table-heading">
          <div>
            <p class="section-kicker">{{ t("common.weekly") }} / {{ t("common.monthly") }}</p>
            <h2>{{ t("common.weekly") }} / {{ t("common.monthly") }}</h2>
            <p class="section-copy">{{ t("person.cadence_copy") }}</p>
          </div>
          <div class="tab-strip secondary-tabs" id="person-cadence-tabs" role="tablist" aria-label="{{ t("common.report_cadence") }}">
            <button type="button" class="tab-button active" id="person-cadence-weekly-tab" role="tab" data-person-cadence="weekly" aria-controls="person-cadence-weekly" aria-selected="true">{{ t("common.weekly") }}</button>
            <button type="button" class="tab-button" id="person-cadence-monthly-tab" role="tab" data-person-cadence="monthly" aria-controls="person-cadence-monthly" aria-selected="false">{{ t("common.monthly") }}</button>
          </div>
        </div>
        <div class="cadence-grid">
          <article class="cadence-panel" id="person-cadence-weekly" role="tabpanel" aria-labelledby="person-cadence-weekly-tab" data-person-cadence-panel="weekly">
            <h3>{{ t("common.weekly_report") }}</h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>{{ t("common.week") }}</th>
                    <th>{{ t("common.state") }}</th>
                    <th class="num">{{ metric_label("authored_pull_request_count") }}</th>
                    <th class="num">{{ metric_label("review_submissions_given") }}</th>
                    <th class="num">{{ metric_label("pull_requests_reviewed") }}</th>
                    <th class="num">{{ metric_label("median_approval_hours") }}</th>
                    <th class="num">{{ metric_label("reviewed_lines") }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% for row in weekly_period_rows_recent %}
                  <tr>
                    <td data-label="{{ t("common.week") }}">{{ row.period_key }}</td>
                    <td data-label="{{ t("common.state") }}">
                      <span class="period-state-pill{% if row.is_open or row.is_partial %} open{% endif %}">{{ period_state(row) }}</span>
                    </td>
                    <td class="num" data-label="{{ metric_text("authored_pull_request_count") }}">{{ row.authored_pull_request_count | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("review_submissions_given") }}">{{ row.review_submissions_given | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("pull_requests_reviewed") }}">{{ row.pull_requests_reviewed | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("median_approval_hours") }}">{{ row.median_approval_hours | duration }}</td>
                    <td class="num" data-label="{{ metric_text("reviewed_lines") }}">{{ row.reviewed_lines | intfmt }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
                {% if weekly_period_rows_older %}
                <tbody id="weekly-period-extra" class="hidden">
                  {% for row in weekly_period_rows_older %}
                  <tr>
                    <td data-label="{{ t("common.week") }}">{{ row.period_key }}</td>
                    <td data-label="{{ t("common.state") }}">
                      <span class="period-state-pill{% if row.is_open or row.is_partial %} open{% endif %}">{{ period_state(row) }}</span>
                    </td>
                    <td class="num" data-label="{{ metric_text("authored_pull_request_count") }}">{{ row.authored_pull_request_count | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("review_submissions_given") }}">{{ row.review_submissions_given | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("pull_requests_reviewed") }}">{{ row.pull_requests_reviewed | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("median_approval_hours") }}">{{ row.median_approval_hours | duration }}</td>
                    <td class="num" data-label="{{ metric_text("reviewed_lines") }}">{{ row.reviewed_lines | intfmt }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
                {% endif %}
              </table>
            </div>
            {% if weekly_period_rows_older %}
            <div class="table-footer">
              <button type="button" id="weekly-period-toggle" class="ghost-button" aria-expanded="false">
                {% if locale == "ko" %}{{ t("common.show_more_rows") }}{% else %}Show {{ [progressive_chunk_size, weekly_period_rows_older|length]|min }} more weekly rows{% endif %}
              </button>
            </div>
            {% endif %}
          </article>
          <article class="cadence-panel hidden" id="person-cadence-monthly" role="tabpanel" aria-labelledby="person-cadence-monthly-tab" data-person-cadence-panel="monthly" hidden>
            <h3>{{ t("common.monthly_report") }}</h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>{{ t("common.month") }}</th>
                    <th>{{ t("common.state") }}</th>
                    <th class="num">{{ metric_label("authored_pull_request_count") }}</th>
                    <th class="num">{{ metric_label("review_submissions_given") }}</th>
                    <th class="num">{{ metric_label("pull_requests_reviewed") }}</th>
                    <th class="num">{{ metric_label("median_approval_hours") }}</th>
                    <th class="num">{{ metric_label("reviewed_lines") }}</th>
                  </tr>
                </thead>
                <tbody>
                  {% for row in monthly_period_rows_recent %}
                  <tr>
                    <td data-label="{{ t("common.month") }}">{{ row.period_key }}</td>
                    <td data-label="{{ t("common.state") }}">
                      <span class="period-state-pill{% if row.is_open or row.is_partial %} open{% endif %}">{{ period_state(row) }}</span>
                    </td>
                    <td class="num" data-label="{{ metric_text("authored_pull_request_count") }}">{{ row.authored_pull_request_count | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("review_submissions_given") }}">{{ row.review_submissions_given | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("pull_requests_reviewed") }}">{{ row.pull_requests_reviewed | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("median_approval_hours") }}">{{ row.median_approval_hours | duration }}</td>
                    <td class="num" data-label="{{ metric_text("reviewed_lines") }}">{{ row.reviewed_lines | intfmt }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
                {% if monthly_period_rows_older %}
                <tbody id="monthly-period-extra" class="hidden">
                  {% for row in monthly_period_rows_older %}
                  <tr>
                    <td data-label="{{ t("common.month") }}">{{ row.period_key }}</td>
                    <td data-label="{{ t("common.state") }}">
                      <span class="period-state-pill{% if row.is_open or row.is_partial %} open{% endif %}">{{ period_state(row) }}</span>
                    </td>
                    <td class="num" data-label="{{ metric_text("authored_pull_request_count") }}">{{ row.authored_pull_request_count | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("review_submissions_given") }}">{{ row.review_submissions_given | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("pull_requests_reviewed") }}">{{ row.pull_requests_reviewed | intfmt }}</td>
                    <td class="num" data-label="{{ metric_text("median_approval_hours") }}">{{ row.median_approval_hours | duration }}</td>
                    <td class="num" data-label="{{ metric_text("reviewed_lines") }}">{{ row.reviewed_lines | intfmt }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
                {% endif %}
              </table>
            </div>
            {% if monthly_period_rows_older %}
            <div class="table-footer">
              <button type="button" id="monthly-period-toggle" class="ghost-button" aria-expanded="false">
                {% if locale == "ko" %}{{ t("common.show_more_rows") }}{% else %}Show {{ [progressive_chunk_size, monthly_period_rows_older|length]|min }} more monthly rows{% endif %}
              </button>
            </div>
            {% endif %}
          </article>
        </div>
      </section>

      <section id="repositories" class="panel section-panel">
        <div class="table-heading">
          <div>
            <p class="section-kicker">{{ t("common.repositories") }}</p>
            <h2>{{ repository_total_count | intfmt }} {{ t("common.repositories") }}</h2>
            <p class="section-copy">{{ t("person.repository_copy") }}</p>
          </div>
        </div>
        <div class="repository-focus-grid">
          {% for row in top_repository_rows %}
          <article class="repository-focus-card">
            <strong>{{ row.repository_full_name }}</strong>
            <span>{{ row.authored_pull_request_count | intfmt }} {{ t("metric.authored_prs") }} / {{ row.review_submissions_given | intfmt }} {{ t("metric.reviews_given") }}</span>
            <span>{{ row.changed_lines_total | intfmt }} {{ t("metric.changed_lines") }} / {{ row.reviewed_lines | intfmt }} {{ t("metric.reviewed_lines") }}</span>
          </article>
          {% endfor %}
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>{{ t("common.repository") }}</th>
                <th class="num">{{ metric_label("authored_pull_request_count") }}</th>
                <th class="num">{{ metric_label("merged_pull_request_count") }}</th>
                <th class="num">{{ metric_label("open_pull_requests") }}</th>
                <th class="num">{{ metric_label("median_merge_hours") }}</th>
                <th class="num">{{ metric_label("median_approval_hours") }}</th>
                <th class="num">{{ metric_label("median_first_review_hours") }}</th>
                <th class="num">{{ metric_label("changed_lines_total") }}</th>
                <th class="num">{{ metric_label("review_submissions_given") }}</th>
                <th class="num">{{ metric_label("pull_requests_reviewed") }}</th>
                <th class="num">{{ metric_label("reviewed_lines") }}</th>
              </tr>
            </thead>
            <tbody>
              {% for row in repository_top_rows %}
              <tr>
                <td data-label="{{ t("common.repository") }}">{{ row.repository_full_name }}</td>
                <td class="num" data-label="{{ metric_text("authored_pull_request_count") }}">{{ row.authored_pull_request_count | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("merged_pull_request_count") }}">{{ row.merged_pull_request_count | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("open_pull_requests") }}">{{ row.open_pull_request_count | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("median_merge_hours") }}">{{ row.median_merge_hours | duration }}</td>
                <td class="num" data-label="{{ metric_text("median_approval_hours") }}">{{ row.median_approval_hours | duration }}</td>
                <td class="num" data-label="{{ metric_text("median_first_review_hours") }}">{{ row.median_first_review_hours | duration }}</td>
                <td class="num" data-label="{{ metric_text("changed_lines_total") }}">{{ row.changed_lines_total | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("review_submissions_given") }}">{{ row.review_submissions_given | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("pull_requests_reviewed") }}">{{ row.pull_requests_reviewed | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("reviewed_lines") }}">{{ row.reviewed_lines | intfmt }}</td>
              </tr>
              {% endfor %}
            </tbody>
            {% if repository_rest_rows %}
            <tbody id="repository-extra" class="hidden">
              {% for row in repository_rest_rows %}
              <tr>
                <td data-label="{{ t("common.repository") }}">{{ row.repository_full_name }}</td>
                <td class="num" data-label="{{ metric_text("authored_pull_request_count") }}">{{ row.authored_pull_request_count | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("merged_pull_request_count") }}">{{ row.merged_pull_request_count | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("open_pull_requests") }}">{{ row.open_pull_request_count | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("median_merge_hours") }}">{{ row.median_merge_hours | duration }}</td>
                <td class="num" data-label="{{ metric_text("median_approval_hours") }}">{{ row.median_approval_hours | duration }}</td>
                <td class="num" data-label="{{ metric_text("median_first_review_hours") }}">{{ row.median_first_review_hours | duration }}</td>
                <td class="num" data-label="{{ metric_text("changed_lines_total") }}">{{ row.changed_lines_total | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("review_submissions_given") }}">{{ row.review_submissions_given | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("pull_requests_reviewed") }}">{{ row.pull_requests_reviewed | intfmt }}</td>
                <td class="num" data-label="{{ metric_text("reviewed_lines") }}">{{ row.reviewed_lines | intfmt }}</td>
              </tr>
              {% endfor %}
            </tbody>
            {% endif %}
          </table>
        </div>
        {% if repository_rest_rows %}
        <div class="table-footer">
          <button type="button" id="repository-toggle" class="ghost-button" aria-expanded="false">
            {% if locale == "ko" %}{{ t("common.show_more_repositories") }}{% else %}Show {{ [progressive_chunk_size, repository_rest_rows|length]|min }} more repositories{% endif %}
          </button>
        </div>
        {% endif %}
      </section>

      <section id="methodology" class="panel section-panel reference-panel">
        <p class="section-kicker">{{ t("common.methodology") }}</p>
        <h2>{{ t("common.methodology") }}</h2>
        <div class="methodology-grid">
          <article class="support-card">
            <strong>{{ metric_text("authored_pull_request_count") }}</strong>
            <span>Authored PRs are filtered by {{ result.time_anchor.value }} and shown in weekly and monthly period tables.</span>
          </article>
          <article class="support-card">
            <strong>{{ metric_text("review_submissions_given") }}</strong>
            <span>Reviews given exclude reviews on the person's own PRs and are grouped by review submission time.</span>
          </article>
          <article class="support-card">
            <strong>{{ metric_text("median_approval_hours") }}</strong>
            <span>Approval speed uses the final external approval on each authored PR.</span>
          </article>
          <article class="support-card">
            <strong>{{ t("common.source_grain") }}</strong>
            <span>Uses normalized orgpulse snapshots already present for the selected organization and anchor.</span>
          </article>
        </div>
      </section>
    </div>
  </div>

  <script id="report-i18n" type="application/json">{{ report_i18n_json }}</script>
  <script id="person-report-data" type="application/json">{{ report_payload | json_script }}</script>
  {% include "person_report/_app.js.j2" %}
</body>
</html>
