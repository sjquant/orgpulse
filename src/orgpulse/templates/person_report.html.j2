<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>orgpulse person metrics: {{ result.login }}</title>
  {% include "common/_theme_bootstrap.js.j2" %}
  {% include "common/_styles.css.j2" %}
  {% include "person_report/_styles.css.j2" %}
</head>
<body>
  <div class="shell person-report">
    <section class="hero">
      <div class="panel hero-panel">
        <div class="hero-head">
          <div class="hero-copy">
            <p class="eyebrow">Person Performance Extract</p>
            <h1>{{ result.login }} performance</h1>
            <p class="subtitle">
              Authored pull request metrics use {{ result.time_anchor.value }}.
              Review-given activity is counted by review submission time.
            </p>
          </div>
          <div class="theme-switch" role="group" aria-label="Color theme">
            <span class="theme-switch-indicator" aria-hidden="true"></span>
            <button type="button" class="theme-switch-button" data-theme-option="dark" aria-label="Dark theme" aria-pressed="false" title="Dark theme">
              <svg class="theme-switch-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 1 0 9.8 9.8Z"></path>
              </svg>
            </button>
            <button type="button" class="theme-switch-button" data-theme-option="light" aria-label="Light theme" aria-pressed="false" title="Light theme">
              <svg class="theme-switch-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4.1"></circle>
                <path d="M12 2.75v2.35"></path>
                <path d="M12 18.9v2.35"></path>
                <path d="M21.25 12h-2.35"></path>
                <path d="M5.1 12H2.75"></path>
                <path d="m18.55 5.45-1.66 1.66"></path>
                <path d="m7.11 16.89-1.66 1.66"></path>
                <path d="m18.55 18.55-1.66-1.66"></path>
                <path d="m7.11 7.11-1.66-1.66"></path>
              </svg>
            </button>
          </div>
        </div>
        <div class="hero-meta">
          <div class="meta-box">
            <span class="meta-label">Organization</span>
            <span class="meta-value">{{ result.target_org }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">Window</span>
            <span class="meta-value">{{ window_label }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">Source grain</span>
            <span class="meta-value">{{ result.grain.value }}</span>
          </div>
          <div class="meta-box">
            <span class="meta-label">Distribution cutoff</span>
            <span class="meta-value">{{ result.distribution_percentile }}th percentile</span>
          </div>
        </div>
      </div>
    </section>

    <section class="stats-grid" aria-label="Person summary metrics">
      <article class="stat-card">
        <span class="stat-label">Authored PRs</span>
        <div class="stat-value">{{ summary.authored_pull_request_count | intfmt }}</div>
        <div class="stat-subvalue">{{ summary.merged_pull_request_count | intfmt }} merged / {{ summary.open_pull_request_count | intfmt }} open</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">Merge rate</span>
        <div class="stat-value">{{ summary.merge_rate_pct | pctfmt }}</div>
        <div class="stat-subvalue">{{ summary.median_merge_hours | duration }} median merge time</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">Review coverage</span>
        <div class="stat-value">{{ summary.review_coverage_pct | pctfmt }}</div>
        <div class="stat-subvalue">{{ summary.reviews_received | intfmt }} review submissions received</div>
      </article>
      <article class="stat-card">
        <span class="stat-label">Reviewed PRs</span>
        <div class="stat-value">{{ reviewer_summary.pull_requests_reviewed | intfmt }}</div>
        <div class="stat-subvalue">{{ reviewer_summary.review_submissions | intfmt }} review submissions / {{ reviewer_summary.pull_requests_reviewed_per_month | numfmt }} PRs per month</div>
      </article>
    </section>

    <section class="summary-strip" aria-label="Additional person metrics">
      <article class="summary-card panel">
        <span class="summary-label">Changed lines</span>
        <strong>{{ summary.changed_lines_total | intfmt }}</strong>
        <span>{{ summary.commits_total | intfmt }} commits across authored PRs</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">Approval speed</span>
        <strong>{{ summary.median_approval_hours | duration }}</strong>
        <span>median time to final approval on authored PRs</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">Review decisions</span>
        <strong>{{ reviewer_summary.approvals | intfmt }} approvals</strong>
        <span>{{ reviewer_summary.changes_requested | intfmt }} changes requested / {{ reviewer_summary.comments | intfmt }} comments</span>
      </article>
      <article class="summary-card panel">
        <span class="summary-label">Reviewed lines</span>
        <strong>{{ reviewer_summary.reviewed_lines | intfmt }}</strong>
        <span>{{ reviewer_summary.reviewed_lines_per_month | numfmt }} lines / month</span>
      </article>
    </section>

    <nav class="section-nav" aria-label="Report sections">
      <a href="#charts">Charts</a>
      <a href="#cadences">Weekly / Monthly</a>
      <a href="#repositories">Repositories</a>
      <a href="#methodology">Methodology</a>
    </nav>

    <div class="section-grid">
      <section id="charts" class="panel section-panel chart-panel">
        <div class="person-chart-toolbar">
          <div>
            <p class="section-kicker">Trend Charts</p>
            <h2>Weekly and monthly movement, graphed</h2>
            <p class="section-copy">Metric and grain tabs use the same local source data as the extract table.</p>
          </div>
        </div>
        {% if result.include_org_trends %}
        <div class="person-chart-grid">
          <div>
            <p class="section-kicker">Org Context</p>
            <h3>Organization trend</h3>
          </div>
          <div class="two-col">
            <div class="tab-strip" id="org-trend-metric-tabs" role="tablist" aria-label="Org trend metric">
              <button type="button" class="tab-button active" data-org-trend-metric="pull_requests" aria-selected="true">PR throughput</button>
              <button type="button" class="tab-button" data-org-trend-metric="pull_requests_per_active_author" aria-selected="false">PRs / active author</button>
              <button type="button" class="tab-button" data-org-trend-metric="changed_lines" aria-selected="false">Changed lines</button>
              <button type="button" class="tab-button" data-org-trend-metric="changed_lines_per_active_author" aria-selected="false">Lines / active author</button>
              <button type="button" class="tab-button" data-org-trend-metric="median_approval_hours" aria-selected="false">Approval time</button>
              <button type="button" class="tab-button" data-org-trend-metric="median_first_review_hours" aria-selected="false">First review</button>
              <button type="button" class="tab-button" data-org-trend-metric="median_merge_hours" aria-selected="false">Merge time</button>
            </div>
            <div class="tab-strip" id="org-trend-grain-tabs" role="tablist" aria-label="Org trend grain">
              <button type="button" class="tab-button active" data-org-trend-grain="weekly" aria-selected="true">Weekly</button>
              <button type="button" class="tab-button" data-org-trend-grain="monthly" aria-selected="false">Monthly</button>
            </div>
          </div>
          <div class="chart-title">
            <span id="org-trend-chart-title">Organization trend</span>
            <div class="chart-legend">
              <span class="legend-chip"><span class="legend-dot" style="background: var(--accent)"></span>Selected metric</span>
              <span class="legend-chip"><span class="legend-band" aria-hidden="true"></span>Yellow band = open period</span>
            </div>
          </div>
          <div id="org-trend-chart-readout" class="chart-readout"></div>
          <div id="org-trend-chart-root" class="chart-root"></div>
        </div>
        {% endif %}
        <div class="two-col">
          <div class="tab-strip primary-tabs" id="person-trend-metric-tabs" role="tablist" aria-label="Trend metric">
            <button type="button" class="tab-button active" data-person-trend-metric="authored_pull_request_count" aria-selected="true">Authored PRs</button>
            <button type="button" class="tab-button" data-person-trend-metric="review_submissions_given" aria-selected="false">Reviews given</button>
            <button type="button" class="tab-button" data-person-trend-metric="pull_requests_reviewed" aria-selected="false">PRs reviewed</button>
            <button type="button" class="tab-button" data-person-trend-metric="reviewed_lines" aria-selected="false">Reviewed lines</button>
            <button type="button" class="tab-button" data-person-trend-metric="median_merge_hours" aria-selected="false">Merge time</button>
            <button type="button" class="tab-button" data-person-trend-metric="median_first_review_hours" aria-selected="false">First review</button>
            <button type="button" class="tab-button" data-person-trend-metric="median_approval_hours" aria-selected="false">Approval</button>
            <button type="button" class="tab-button" data-person-trend-metric="changed_lines_total" aria-selected="false">Changed lines</button>
            <button type="button" class="tab-button" data-person-trend-metric="commits_total" aria-selected="false">Commits</button>
          </div>
          <div class="tab-strip secondary-tabs" id="person-trend-grain-tabs" role="tablist" aria-label="Trend grain">
            <button type="button" class="tab-button active" data-person-trend-grain="weekly" aria-selected="true">Weekly</button>
            <button type="button" class="tab-button" data-person-trend-grain="monthly" aria-selected="false">Monthly</button>
          </div>
        </div>
        <div class="person-chart-grid">
          <div class="chart-title">
            <span id="person-trend-chart-title">Person trend</span>
            <div class="chart-legend">
              <span class="legend-chip"><span class="legend-dot" style="background: var(--accent)"></span>Selected metric</span>
              <span class="legend-chip"><span class="legend-band" aria-hidden="true"></span>Yellow band = open period</span>
            </div>
          </div>
          <div id="person-trend-chart-readout" class="chart-readout"></div>
          <div id="person-trend-chart-root" class="chart-root"></div>
        </div>
      </section>

      <section id="cadences" class="panel section-panel">
        <div class="table-heading">
          <div>
            <p class="section-kicker">Cadence Reports</p>
            <h2>Weekly and monthly reports</h2>
            <p class="section-copy">Both cadences are available in HTML so review and author movement can be compared without rerunning the extract.</p>
          </div>
          <div class="tab-strip secondary-tabs" id="person-cadence-tabs" role="tablist" aria-label="Report cadence">
            <button type="button" class="tab-button active" id="person-cadence-weekly-tab" role="tab" data-person-cadence="weekly" aria-controls="person-cadence-weekly" aria-selected="true">Weekly</button>
            <button type="button" class="tab-button" id="person-cadence-monthly-tab" role="tab" data-person-cadence="monthly" aria-controls="person-cadence-monthly" aria-selected="false">Monthly</button>
          </div>
        </div>
        <div class="cadence-grid">
          <article class="cadence-panel" id="person-cadence-weekly" role="tabpanel" aria-labelledby="person-cadence-weekly-tab" data-person-cadence-panel="weekly">
            <h3>Weekly report</h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Week</th>
                    <th>State</th>
                    <th class="num">Authored PRs</th>
                    <th class="num">Reviews Given</th>
                    <th class="num">PRs Reviewed</th>
                    <th class="num">Approval Time</th>
                    <th class="num">Reviewed Lines</th>
                  </tr>
                </thead>
                <tbody>
                  {% for row in weekly_period_rows_recent %}
                  <tr>
                    <td data-label="Week">{{ row.period_key }}</td>
                    <td data-label="State">
                      <span class="period-state-pill{% if row.is_open or row.is_partial %} open{% endif %}">{{ row.label }}</span>
                    </td>
                    <td class="num" data-label="Authored PRs">{{ row.authored_pull_request_count | intfmt }}</td>
                    <td class="num" data-label="Reviews Given">{{ row.review_submissions_given | intfmt }}</td>
                    <td class="num" data-label="PRs Reviewed">{{ row.pull_requests_reviewed | intfmt }}</td>
                    <td class="num" data-label="Approval Time">{{ row.median_approval_hours | duration }}</td>
                    <td class="num" data-label="Reviewed Lines">{{ row.reviewed_lines | intfmt }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
                {% if weekly_period_rows_older %}
                <tbody id="weekly-period-extra" class="hidden">
                  {% for row in weekly_period_rows_older %}
                  <tr>
                    <td data-label="Week">{{ row.period_key }}</td>
                    <td data-label="State">
                      <span class="period-state-pill{% if row.is_open or row.is_partial %} open{% endif %}">{{ row.label }}</span>
                    </td>
                    <td class="num" data-label="Authored PRs">{{ row.authored_pull_request_count | intfmt }}</td>
                    <td class="num" data-label="Reviews Given">{{ row.review_submissions_given | intfmt }}</td>
                    <td class="num" data-label="PRs Reviewed">{{ row.pull_requests_reviewed | intfmt }}</td>
                    <td class="num" data-label="Approval Time">{{ row.median_approval_hours | duration }}</td>
                    <td class="num" data-label="Reviewed Lines">{{ row.reviewed_lines | intfmt }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
                {% endif %}
              </table>
            </div>
            {% if weekly_period_rows_older %}
            <div class="table-footer">
              <button type="button" id="weekly-period-toggle" class="ghost-button" aria-expanded="false">
                Show {{ [progressive_chunk_size, weekly_period_rows_older|length]|min }} more weekly rows
              </button>
            </div>
            {% endif %}
          </article>
          <article class="cadence-panel hidden" id="person-cadence-monthly" role="tabpanel" aria-labelledby="person-cadence-monthly-tab" data-person-cadence-panel="monthly" hidden>
            <h3>Monthly report</h3>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Month</th>
                    <th>State</th>
                    <th class="num">Authored PRs</th>
                    <th class="num">Reviews Given</th>
                    <th class="num">PRs Reviewed</th>
                    <th class="num">Approval Time</th>
                    <th class="num">Reviewed Lines</th>
                  </tr>
                </thead>
                <tbody>
                  {% for row in monthly_period_rows_recent %}
                  <tr>
                    <td data-label="Month">{{ row.period_key }}</td>
                    <td data-label="State">
                      <span class="period-state-pill{% if row.is_open or row.is_partial %} open{% endif %}">{{ row.label }}</span>
                    </td>
                    <td class="num" data-label="Authored PRs">{{ row.authored_pull_request_count | intfmt }}</td>
                    <td class="num" data-label="Reviews Given">{{ row.review_submissions_given | intfmt }}</td>
                    <td class="num" data-label="PRs Reviewed">{{ row.pull_requests_reviewed | intfmt }}</td>
                    <td class="num" data-label="Approval Time">{{ row.median_approval_hours | duration }}</td>
                    <td class="num" data-label="Reviewed Lines">{{ row.reviewed_lines | intfmt }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
                {% if monthly_period_rows_older %}
                <tbody id="monthly-period-extra" class="hidden">
                  {% for row in monthly_period_rows_older %}
                  <tr>
                    <td data-label="Month">{{ row.period_key }}</td>
                    <td data-label="State">
                      <span class="period-state-pill{% if row.is_open or row.is_partial %} open{% endif %}">{{ row.label }}</span>
                    </td>
                    <td class="num" data-label="Authored PRs">{{ row.authored_pull_request_count | intfmt }}</td>
                    <td class="num" data-label="Reviews Given">{{ row.review_submissions_given | intfmt }}</td>
                    <td class="num" data-label="PRs Reviewed">{{ row.pull_requests_reviewed | intfmt }}</td>
                    <td class="num" data-label="Approval Time">{{ row.median_approval_hours | duration }}</td>
                    <td class="num" data-label="Reviewed Lines">{{ row.reviewed_lines | intfmt }}</td>
                  </tr>
                  {% endfor %}
                </tbody>
                {% endif %}
              </table>
            </div>
            {% if monthly_period_rows_older %}
            <div class="table-footer">
              <button type="button" id="monthly-period-toggle" class="ghost-button" aria-expanded="false">
                Show {{ [progressive_chunk_size, monthly_period_rows_older|length]|min }} more monthly rows
              </button>
            </div>
            {% endif %}
          </article>
        </div>
      </section>

      <section id="repositories" class="panel section-panel">
        <div class="table-heading">
          <div>
            <p class="section-kicker">Repository Focus</p>
            <h2>{{ repository_total_count | intfmt }} repositories with person activity</h2>
            <p class="section-copy">Top repositories are ranked by authored PR count, then review activity and code volume.</p>
          </div>
        </div>
        <div class="repository-focus-grid">
          {% for row in top_repository_rows %}
          <article class="repository-focus-card">
            <strong>{{ row.repository_full_name }}</strong>
            <span>{{ row.authored_pull_request_count | intfmt }} authored PRs / {{ row.review_submissions_given | intfmt }} reviews given</span>
            <span>{{ row.changed_lines_total | intfmt }} changed / {{ row.reviewed_lines | intfmt }} reviewed lines</span>
          </article>
          {% endfor %}
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Repository</th>
                <th class="num">Authored PRs</th>
                <th class="num">Merged</th>
                <th class="num">Open</th>
                <th class="num">Median Merge</th>
                <th class="num">Approval Time</th>
                <th class="num">Median First Review</th>
                <th class="num">Changed Lines</th>
                <th class="num">Reviews Given</th>
                <th class="num">PRs Reviewed</th>
                <th class="num">Reviewed Lines</th>
              </tr>
            </thead>
            <tbody>
              {% for row in repository_top_rows %}
              <tr>
                <td data-label="Repository">{{ row.repository_full_name }}</td>
                <td class="num" data-label="Authored PRs">{{ row.authored_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Merged">{{ row.merged_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Open">{{ row.open_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Median Merge">{{ row.median_merge_hours | duration }}</td>
                <td class="num" data-label="Approval Time">{{ row.median_approval_hours | duration }}</td>
                <td class="num" data-label="Median First Review">{{ row.median_first_review_hours | duration }}</td>
                <td class="num" data-label="Changed Lines">{{ row.changed_lines_total | intfmt }}</td>
                <td class="num" data-label="Reviews Given">{{ row.review_submissions_given | intfmt }}</td>
                <td class="num" data-label="PRs Reviewed">{{ row.pull_requests_reviewed | intfmt }}</td>
                <td class="num" data-label="Reviewed Lines">{{ row.reviewed_lines | intfmt }}</td>
              </tr>
              {% endfor %}
            </tbody>
            {% if repository_rest_rows %}
            <tbody id="repository-extra" class="hidden">
              {% for row in repository_rest_rows %}
              <tr>
                <td data-label="Repository">{{ row.repository_full_name }}</td>
                <td class="num" data-label="Authored PRs">{{ row.authored_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Merged">{{ row.merged_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Open">{{ row.open_pull_request_count | intfmt }}</td>
                <td class="num" data-label="Median Merge">{{ row.median_merge_hours | duration }}</td>
                <td class="num" data-label="Approval Time">{{ row.median_approval_hours | duration }}</td>
                <td class="num" data-label="Median First Review">{{ row.median_first_review_hours | duration }}</td>
                <td class="num" data-label="Changed Lines">{{ row.changed_lines_total | intfmt }}</td>
                <td class="num" data-label="Reviews Given">{{ row.review_submissions_given | intfmt }}</td>
                <td class="num" data-label="PRs Reviewed">{{ row.pull_requests_reviewed | intfmt }}</td>
                <td class="num" data-label="Reviewed Lines">{{ row.reviewed_lines | intfmt }}</td>
              </tr>
              {% endfor %}
            </tbody>
            {% endif %}
          </table>
        </div>
        {% if repository_rest_rows %}
        <div class="table-footer">
          <button type="button" id="repository-toggle" class="ghost-button" aria-expanded="false">
            Show {{ [progressive_chunk_size, repository_rest_rows|length]|min }} more repositories
          </button>
        </div>
        {% endif %}
      </section>

      <section id="methodology" class="panel section-panel reference-panel">
        <p class="section-kicker">Methodology</p>
        <h2>How this extract is counted</h2>
        <div class="methodology-grid">
          <article class="support-card">
            <strong>Authored work</strong>
            <span>Authored PRs are filtered by {{ result.time_anchor.value }} and shown in weekly and monthly period tables.</span>
          </article>
          <article class="support-card">
            <strong>Review work</strong>
            <span>Reviews given exclude reviews on the person's own PRs and are grouped by review submission time.</span>
          </article>
          <article class="support-card">
            <strong>Approval speed</strong>
            <span>Approval speed uses the final external approval on each authored PR.</span>
          </article>
          <article class="support-card">
            <strong>Source</strong>
            <span>Uses normalized orgpulse snapshots already present for the selected organization and anchor.</span>
          </article>
        </div>
      </section>
    </div>
  </div>

  <script id="person-report-data" type="application/json">{{ report_payload | json_script }}</script>
  {% include "person_report/_app.js.j2" %}
</body>
</html>
